---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada | Nota Fácil Downloader" description="A página que você procurou não existe ou mudou de endereço." robots="noindex, follow">
    <section class="min-h-[60vh] flex items-center justify-center px-4 py-24 text-center">
        <div class="max-w-xl">
            <p class="text-sm font-bold text-blue-600 mb-3">Erro 404</p>
            <h1 class="text-4xl font-black text-slate-900 mb-4 tracking-tight">Página não encontrada</h1>
            <p class="text-lg text-slate-600 mb-8">O endereço não existe ou mudou. Volte ao início ou veja as novidades no blog.</p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a href="/" class="inline-flex justify-center bg-blue-600 text-white font-bold px-6 py-3 rounded-xl hover:bg-blue-700">Ir para o início</a>
                <a href="/blog/" class="inline-flex justify-center bg-white text-slate-900 font-bold px-6 py-3 rounded-xl border border-slate-200 hover:bg-slate-50">Ver o blog</a>
            </div>
        </div>
    </section>
</BaseLayout>

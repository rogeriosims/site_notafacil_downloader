---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Download Iniciado | Nota Fácil Downloader" description="O robô está sendo preparado para você." bodyClass="bg-slate-950 text-white overflow-x-hidden selection:bg-blue-600 selection:text-white">

    <!-- Glows Sutis nas bordas (removido fundo fixo que cobria o rodapé) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-600/10 rounded-full blur-[120px]"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-indigo-600/10 rounded-full blur-[120px]"></div>
    </div>

    <!-- Conteúdo Principal -->
    <section class="relative z-10 pt-32 pb-24 min-h-[70vh] flex flex-col justify-center">
        <div class="container mx-auto px-6 max-w-4xl">
            
            <!-- Status de Download -->
            <div class="text-center mb-16" data-aos="fade-down">
                <div class="inline-flex items-center justify-center w-24 h-24 bg-emerald-500/10 text-emerald-400 rounded-full mb-8 border border-emerald-500/30 shadow-[0_0_50px_rgba(16,185,129,0.3)]">
                    <i data-lucide="check-circle" class="w-12 h-12"></i>
                </div>
                <h1 id="boas-vindas-titulo" class="text-4xl sm:text-6xl font-black text-white tracking-tight mb-6">
                    Seu Robô está a caminho!
                </h1>
                <p id="boas-vindas-sub" class="text-xl text-slate-300 font-medium max-w-2xl mx-auto leading-relaxed">
                    Estamos gerando a licença do seu escritório. O download iniciará em <span id="countdown" class="text-blue-400 font-black">3</span> segundos.
                </p>
                
                <!-- Fallback manual -->
                <div class="mt-12 hidden" id="manual-download-box">
                    <p class="text-sm text-slate-500 mb-4 font-bold uppercase tracking-widest">O download não começou?</p>
                    <a href="#" id="btn-manual-download" class="inline-flex items-center gap-4 bg-blue-600 hover:bg-blue-500 text-white px-10 py-5 rounded-2xl font-black transition-all shadow-xl shadow-blue-600/30 active:scale-95 text-lg">
                        <i data-lucide="download" class="w-6 h-6"></i>
                        BAIXAR AGORA
                    </a>
                </div>
            </div>

            <!-- Card de Instruções Premium -->
            <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8 sm:p-14 shadow-2xl relative overflow-hidden" data-aos="fade-up">
                <div class="absolute top-0 right-0 w-96 h-96 bg-blue-600/5 rounded-full blur-[120px]"></div>
                
                <h2 class="text-2xl sm:text-3xl font-black text-white mb-12 text-center flex items-center justify-center gap-4">
                    <i data-lucide="shield-check" class="text-blue-500 w-8 h-8"></i>
                    Ativação em 3 Passos Rápidos
                </h2>

                <div class="grid md:grid-cols-3 gap-10">
                    <!-- PASSO 1 -->
                    <div class="relative group">
                        <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center text-white font-black text-xl mb-4 shadow-lg shadow-blue-500/30">1</div>
                        <h3 class="text-lg font-bold text-white mb-2">Abra o Instalador</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            Assim que o arquivo <span class="bg-slate-900 text-blue-300 px-1 py-0.5 rounded text-xs font-mono">Nota_Facil_Downloader_Setup.exe</span> terminar de baixar, clique nele para abrir.
                        </p>
                    </div>

                    <!-- PASSO 2 -->
                    <div class="relative group">
                        <div class="w-10 h-10 bg-slate-700 rounded-lg flex items-center justify-center text-white font-black text-xl mb-4 border border-slate-600">2</div>
                        <h3 class="text-lg font-bold text-white mb-2">Windows Defender</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            O Windows pode bloquear softwares novos. É seguro. Clique em <span class="text-white font-semibold">"Mais informações"</span> e depois em <span class="text-white font-semibold flex items-center gap-1 mt-1"><i data-lucide="shield-check" class="w-4 h-4 text-emerald-500 inline"></i> "Executar assim mesmo"</span>.
                        </p>
                    </div>

                    <!-- PASSO 3 -->
                    <div class="relative group">
                        <div class="w-10 h-10 bg-slate-700 rounded-lg flex items-center justify-center text-white font-black text-xl mb-4 border border-slate-600">3</div>
                        <h3 class="text-lg font-bold text-white mb-2">Ative a Licença</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            Na primeira tela do sistema, insira o seu e-mail cadastrado <span id="email-licenca" class="block font-mono bg-slate-900 text-emerald-400 p-1.5 rounded mt-2 border border-slate-800 overflow-x-auto whitespace-nowrap text-xs">seu@email.com</span>
                        </p>
                    </div>
                </div>


            </div>
        </div>
    </section>

    <!-- DOBRA FINAL: CTA IGUAL À HOME PARA CONTINUIDADE VISUAL -->
    <section class="py-24 bg-blue-600 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20">
        </div>
        <div class="container mx-auto px-6 text-center relative z-10">
            <h2 class="text-3xl lg:text-4xl font-black text-white mb-6">Pronto para transformar sua rotina contábil?</h2>
            <p class="text-xl text-blue-100 font-medium mb-10 max-w-2xl mx-auto">Seu robô já está baixando. Se precisar de ajuda, nosso suporte está a um clique no rodapé.</p>
            <a href="https://wa.me/5531998913498" target="_blank"
                class="inline-block bg-white text-blue-600 px-10 py-5 rounded-2xl font-black shadow-2xl transition transform hover:-translate-y-2 hover:shadow-blue-900/50 active:scale-95 text-xl tracking-tight">FALAR COM ESPECIALISTA</a>
        </div>
    </section>

    <!-- Scripts de Lógica (Preservados) -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            const rawData = sessionStorage.getItem('notafacil_user_data');
            const countdownEl = document.getElementById('countdown');
            const manualBox = document.getElementById('manual-download-box');
            const btnManual = document.getElementById('btn-manual-download');
            const fallbackUrl = 'https://pub-326d6d17ab0342ed9e2227ab523d3179.r2.dev/Nota_Facil_Downloader_Setup.exe';

            let downloadUrl = fallbackUrl;
            let emailParam = 'seu@email.com';

            if (rawData) {
                try {
                    const responseJson = JSON.parse(rawData);
                    const userData = responseJson.data || responseJson;
                    downloadUrl = responseJson.url_download || userData.url_download || fallbackUrl;
                    
                    const pPrimeiroNome = userData.nome ? userData.nome.split(' ')[0] : 'Contador(a)';
                    const razaoSocial = userData.razao_social || 'seu escritório';
                    emailParam = userData.email || 'seu email cadastrado';
                    const planName = userData.plano || 'Free';

                    document.getElementById('boas-vindas-titulo').innerText = `Tudo pronto, ${pPrimeiroNome}!`;
                    document.getElementById('boas-vindas-sub').innerHTML = `A licença <strong>${planName}</strong> para <span class="text-white font-bold">${razaoSocial}</span> foi gerada. O download iniciará em <span id="countdown" class="text-blue-400 font-black">3</span> segundos.`;
                    document.getElementById('email-licenca').innerText = emailParam;
                } catch (e) {
                    console.error("Erro dados sessao", e);
                }
            }

            // Garantir protocolo no link manual
            const finalLink = downloadUrl.startsWith('http') ? downloadUrl : 'https://' + downloadUrl;
            btnManual.href = finalLink;

            let timeLeft = 3;
            const timer = setInterval(() => {
                timeLeft--;
                const countDisplay = document.getElementById('countdown');
                if (countDisplay) countDisplay.innerText = timeLeft;

                if (timeLeft <= 0) {
                    clearInterval(timer);
                    window.location.href = finalLink;
                    manualBox.classList.remove('hidden');
                }
            }, 1000);
        });
    </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Download Iniciado | Nota Fácil Downloader" description="O robô está sendo preparado para você." bodyClass="bg-slate-50 text-slate-900 overflow-x-hidden selection:bg-blue-600 selection:text-white" robots="noindex, nofollow">

    <!-- Modal de Transição (instalação via Loja Windows) -->
    <div id="store-modal" class="fixed inset-0 z-50 hidden bg-slate-900/80 backdrop-blur-sm flex items-center justify-center opacity-0 transition-opacity duration-300">
        <div class="bg-white p-10 rounded-[2.5rem] shadow-2xl max-w-lg w-full text-center transform scale-95 transition-transform duration-300 relative border border-slate-200" id="store-modal-content">
            <button onclick="closeModal()" aria-label="Fechar aviso de instalação" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 transition-colors">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
            <div class="w-20 h-20 bg-blue-50 text-blue-600 rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-inner">
                <i data-lucide="shield-check" class="w-10 h-10"></i>
            </div>
            <h3 class="text-3xl font-black text-slate-900 mb-4 tracking-tight">Instalação segura em andamento</h3>
            <p class="text-lg text-slate-600 font-medium mb-8 leading-relaxed">Clique em <strong class="text-slate-900 bg-slate-100 px-2 py-1 rounded">Abrir</strong> na janela pop-up do seu Windows para iniciar a instalação certificada.</p>
            <div class="w-12 h-12 border-4 border-blue-100 border-t-blue-600 rounded-full animate-spin mx-auto"></div>
        </div>
    </div>

    <!-- Fundo Suave -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-100/50 rounded-full blur-[120px] -mr-48 -mt-48"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-100/30 rounded-full blur-[120px] -ml-48 -mb-48"></div>
    </div>

    <!-- Conteúdo Principal -->
    <section class="relative z-10 pt-32 pb-32 min-h-screen flex flex-col justify-center">
        <div class="container mx-auto px-6 max-w-6xl">
            
            <!-- Hero de Sucesso -->
            <div class="text-center mb-24" data-aos="fade-down">
                <p id="saudacao-usuario" class="hidden text-blue-600 font-black uppercase tracking-widest text-sm mb-6"></p>
                <h1 id="titulo-download" class="text-5xl sm:text-7xl font-black text-slate-900 tracking-normal mb-8 uppercase">
                    Seu Robô está <br class="hidden sm:block"/><span class="text-blue-600">a caminho!</span>
                </h1>
                <p id="subtitulo-download" class="text-xl text-slate-500 font-medium max-w-2xl mx-auto leading-relaxed">
                    O download foi liberado para o seu escritório. Escolha abaixo a versão que deseja instalar para começar agora mesmo.
                </p>
            </div>

            <!-- Escolha de Caminho -->
            <div class="grid lg:grid-cols-5 gap-8 items-stretch mb-32">
                <!-- Card Microsoft Store (Destaque) -->
                <div class="lg:col-span-3 bg-slate-900 border border-slate-800 p-10 sm:p-16 rounded-[3.5rem] shadow-2xl relative overflow-hidden group" data-aos="fade-right">
                    <div class="absolute top-0 right-0 w-80 h-80 bg-blue-600/20 rounded-full blur-[100px] -mr-40 -mt-40 transition-transform group-hover:scale-110"></div>
                    
                    <div class="relative z-10">
                        <div class="inline-flex items-center gap-3 px-5 py-2 bg-blue-500/20 text-blue-400 rounded-full text-xs font-black uppercase tracking-widest mb-10 border border-blue-500/30">
                            <i data-lucide="award" class="w-4 h-4 text-blue-400"></i> Oficial Microsoft
                        </div>
                        <h2 class="text-4xl sm:text-5xl font-black text-white mb-8 uppercase tracking-normal">Versão Loja <br/>Recomendada</h2>
                        <p class="text-slate-400 text-lg mb-12 leading-relaxed max-w-md">
                            Instalação 100% segura com <strong>atualizações automáticas</strong> e o novo motor de Geração Local de PDF (50x mais rápido).
                        </p>
                        
                        <a href="ms-windows-store://pdp/?productid=9N4GBNDFL550"
                           onclick="openStoreModal(); window.dataLayer = window.dataLayer || []; window.dataLayer.push({'event': 'download_store'});"
                           class="inline-flex items-center gap-4 bg-white text-slate-900 px-12 py-6 rounded-2xl font-black transition-all shadow-xl hover:scale-105 active:scale-95 text-xl group">
                            <i data-lucide="shopping-bag" class="w-7 h-7 text-blue-600"></i>
                            OBTER NA LOJA OFICIAL
                        </a>
                    </div>
                </div>

                <!-- Card Download EXE -->
                <div class="lg:col-span-2 bg-white border border-slate-200 p-10 sm:p-12 rounded-[3.5rem] shadow-sm flex flex-col justify-between" data-aos="fade-left">
                    <div>
                        <div class="w-16 h-16 bg-slate-50 text-slate-400 rounded-2xl flex items-center justify-center mb-10 border border-slate-100">
                            <i data-lucide="download-cloud" class="w-8 h-8"></i>
                        </div>
                        <h3 class="text-2xl font-black text-slate-900 mb-6 uppercase tracking-normal">Instalador EXE</h3>
                        <p class="text-slate-500 text-base leading-relaxed mb-10">
                            A versão clássica para quem prefere gerenciar a instalação manualmente.
                        </p>
                    </div>

                    <div class="space-y-4">
                        <a href="https://notafacildownloader.contabilcert.com.br/instalar-nota-facil"
                           onclick="window.dataLayer = window.dataLayer || []; window.dataLayer.push({'event': 'download_exe'});"
                           class="w-full bg-slate-900 text-white py-5 rounded-2xl font-black text-center block transition-all hover:bg-slate-800 shadow-lg">
                            BAIXAR ARQUIVO .EXE
                        </a>
                        <!-- Ajuda EXE -->
                        <div class="bg-blue-50/50 p-4 rounded-2xl border border-blue-100">
                            <p class="text-[10px] text-blue-800 font-bold leading-tight flex gap-2">
                                <i data-lucide="info" class="w-4 h-4 shrink-0"></i>
                                Caso o navegador ou o Windows exibam avisos de segurança, clique em "Manter" e "Executar assim mesmo".
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Guia de Instalação -->
            <div class="space-y-10 mb-32">
                <h2 class="text-3xl font-black text-slate-900 text-center mb-16 uppercase tracking-normal" data-aos="fade-up">Passo a passo para começar</h2>
                
                <div class="grid md:grid-cols-3 gap-8">
                    <div class="bg-white p-10 rounded-[3rem] border border-slate-200 relative group transition-all hover:-translate-y-2" data-aos="fade-up" data-aos-delay="100">
                        <span class="absolute -top-6 -left-6 w-16 h-16 bg-slate-900 text-white rounded-2xl flex items-center justify-center text-2xl font-black italic shadow-2xl">01</span>
                        <h4 class="text-xl font-black text-slate-900 mb-4 mt-4 uppercase">Instale o Robô</h4>
                        <p class="text-slate-500 leading-relaxed">Clique no botão da Loja Windows (Recomendado) ou execute o instalador EXE baixado.</p>
                    </div>
                    <div class="bg-white p-10 rounded-[3rem] border border-slate-200 relative group transition-all hover:-translate-y-2" data-aos="fade-up" data-aos-delay="200">
                        <span class="absolute -top-6 -left-6 w-16 h-16 bg-blue-600 text-white rounded-2xl flex items-center justify-center text-2xl font-black italic shadow-2xl">02</span>
                        <h4 class="text-xl font-black text-slate-900 mb-4 mt-4 uppercase">Ative seu Acesso</h4>
                        <p class="text-slate-500 leading-relaxed">Abra o sistema e informe o seu e-mail de licença para liberar as rotinas de download.</p>
                    </div>
                    <div class="bg-white p-10 rounded-[3rem] border border-slate-200 relative group transition-all hover:-translate-y-2" data-aos="fade-up" data-aos-delay="300">
                        <span class="absolute -top-6 -left-6 w-16 h-16 bg-emerald-500 text-white rounded-2xl flex items-center justify-center text-2xl font-black italic shadow-2xl">03</span>
                        <h4 class="text-xl font-black text-slate-900 mb-4 mt-4 uppercase">Bons Downloads!</h4>
                        <p class="text-slate-500 leading-relaxed">Configure seus certificados e deixe o Nota Fácil trabalhar por você no piloto automático.</p>
                    </div>
                </div>
            </div>

            <!-- Painel de Segurança (Unificado) -->
            <div class="bg-slate-900 rounded-[4rem] p-12 sm:p-20 text-white shadow-2xl relative overflow-hidden" data-aos="zoom-in">
                <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-600/10 rounded-full blur-[120px] -mr-96 -mt-96"></div>
                
                <div class="flex flex-col lg:flex-row gap-20 items-center relative z-10">
                    <div class="lg:w-3/5">
                        <div class="flex items-center gap-6 mb-12">
                            <div class="w-20 h-20 bg-emerald-500/20 rounded-3xl flex items-center justify-center border border-emerald-500/30 shadow-lg">
                                <i data-lucide="shield-check" class="w-10 h-10 text-emerald-400"></i>
                            </div>
                            <h2 class="text-4xl sm:text-5xl font-black text-white tracking-normal uppercase leading-tight">Software Verificado <br/>pela Microsoft Store</h2>
                        </div>
                        <p class="text-slate-400 text-xl leading-relaxed mb-10">
                            A aprovação oficial na loja do Windows confirma o Nota Fácil como um software seguro, auditado e livre de malwares, garantindo a conformidade total com a LGPD e o Sigilo Fiscal.
                        </p>
                        <div class="flex flex-wrap gap-8 opacity-60">
                            <div class="flex items-center gap-3">
                                <i data-lucide="lock" class="w-5 h-5 text-slate-500"></i>
                                <span class="text-xs font-black uppercase tracking-[0.2em]">Sigilo Fiscal 100%</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <i data-lucide="cpu" class="w-5 h-5 text-slate-500"></i>
                                <span class="text-xs font-black uppercase tracking-[0.2em]">Processamento Local</span>
                            </div>
                        </div>
                    </div>
                    <div class="lg:w-2/5 w-full">
                        <a href="https://wa.me/5531998913498" target="_blank" class="block group">
                            <div class="bg-white/5 border border-white/10 p-10 rounded-[3rem] text-center hover:bg-white/10 transition-all hover:scale-105">
                                <div class="w-16 h-16 bg-emerald-500 text-white rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
                                    <i data-lucide="message-circle" class="w-8 h-8"></i>
                                </div>
                                <h4 class="text-2xl font-black text-white mb-4 uppercase tracking-normal">Dificuldades Técnicas?</h4>
                                <p class="text-slate-400 font-medium mb-8">Fale agora com nosso suporte via WhatsApp para uma instalação assistida.</p>
                                <span class="text-emerald-400 font-black text-xs uppercase tracking-widest group-hover:underline">Chamar no WhatsApp &rarr;</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- DOBRA FINAL -->
    <section class="py-20 border-t border-slate-100 bg-white">
        <div class="container mx-auto px-6 text-center">
            <h2 class="text-3xl font-black text-slate-900 mb-6 uppercase">Tudo pronto para transformar sua rotina?</h2>
            <p class="text-lg text-slate-600 font-medium mb-10 max-w-2xl mx-auto tracking-normal">Se precisar de qualquer ajuda durante a configuração inicial, nosso time técnico está à disposição.</p>
            <a href="https://wa.me/5531998913498" target="_blank" class="inline-block bg-blue-600 text-white px-10 py-5 rounded-2xl font-black shadow-xl shadow-blue-200 transition transform hover:-translate-y-1 active:scale-95 text-xl tracking-normal uppercase">FALAR COM SUPORTE TÉCNICO</a>
        </div>
    </section>

    <script is:inline>
        window.openStoreModal = function () {
            const modal = document.getElementById('store-modal');
            const content = document.getElementById('store-modal-content');
            if (modal && content) {
                modal.classList.remove('hidden');
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    content.classList.remove('scale-95');
                }, 10);
            }
        };

        window.closeModal = function () {
            const modal = document.getElementById('store-modal');
            const content = document.getElementById('store-modal-content');
            if (modal && content) {
                modal.classList.add('opacity-0');
                content.classList.add('scale-95');
                setTimeout(() => modal.classList.add('hidden'), 300);
            }
        };

        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) window.lucide.createIcons();

            // Personalização a partir dos dados gravados pelo formulário da home.
            // Quem já tinha cadastro (returning) recebe uma mensagem de reinstalação,
            // não de boas-vindas — o texto padrão só vale para cadastro novo.
            try {
                const dados = JSON.parse(sessionStorage.getItem('notafacil_user_data') || '{}');
                const nome = (dados.nome || '').trim().split(' ')[0];
                const saudacao = document.getElementById('saudacao-usuario');
                const titulo = document.getElementById('titulo-download');
                const subtitulo = document.getElementById('subtitulo-download');

                if (dados.returning) {
                    if (saudacao) {
                        saudacao.innerText = nome ? `Bem-vindo de volta, ${nome}!` : 'Bem-vindo de volta!';
                        saudacao.classList.remove('hidden');
                    }
                    if (titulo) {
                        titulo.innerHTML = 'Sua licença <br class="hidden sm:block"/><span class="text-blue-600">continua ativa</span>';
                    }
                    if (subtitulo) {
                        subtitulo.innerText = 'Seu escritório já tem cadastro conosco. Baixe o robô novamente abaixo — é só instalar e ativar com o mesmo e-mail de sempre.';
                    }
                } else if (nome && saudacao) {
                    saudacao.innerText = `Cadastro confirmado, ${nome}!`;
                    saudacao.classList.remove('hidden');
                }
            } catch (err) {
                // Sem dados de sessão: a página segue com o texto padrão.
            }
        });
    </script>
</BaseLayout>

    <!-- Scripts de Interação (Client-side) -->
    <script>
        // Declarar no escopo global
        window.openStoreModal = function() {
            const modal = document.getElementById('store-modal');
            const content = document.getElementById('store-modal-content');
            if(modal && content) {
                modal.classList.remove('hidden');
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    content.classList.remove('scale-95');
                }, 10);
            }
        };

        window.closeModal = function() {
            const modal = document.getElementById('store-modal');
            const content = document.getElementById('store-modal-content');
            if(modal && content) {
                modal.classList.add('opacity-0');
                content.classList.add('scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }
        };

        // Lógica da Calculadora de ROI
        window.setSliderValue = function(val) {
            const slider = document.getElementById('calc-slider');
            if (slider) {
                slider.value = val.toString();
                // Dispara o evento de input manual para atualizar os valores
                slider.dispatchEvent(new Event('input'));
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            // Escassez Dinâmica
            const countEl = document.getElementById('vagas-count');
            if(countEl) {
                setTimeout(() => {
                    countEl.innerText = '12';
                    countEl.classList.add('text-red-600', 'scale-125');
                    setTimeout(() => countEl.classList.remove('scale-125'), 300);
                }, 4000);
            }

            // Lógica de Exibição por Data (Mostra apenas do dia 28 ao dia 5)
            const today = new Date();
            const day = today.getDate();
            const fundadoresSection = document.getElementById('fundadores-section');
            
            // Se for maior ou igual a 28, ou menor ou igual a 5
            if (fundadoresSection && (day >= 28 || day <= 5)) {
                fundadoresSection.classList.remove('hidden');
            }

            // Lógica de atualização dinâmica da Calculadora
            const slider = document.getElementById('calc-slider');
            const notasVal = document.getElementById('calc-notas-val');
            const manualCost = document.getElementById('calc-manual-cost');
            const manualHours = document.getElementById('calc-manual-hours');
            const planCost = document.getElementById('calc-plan-cost');
            const planName = document.getElementById('calc-plan-name');
            const savingsVal = document.getElementById('calc-savings-val');
            const savingsAnnual = document.getElementById('calc-savings-annual');
            const roiVal = document.getElementById('calc-roi-val');

            function updateCalculator(value) {
                if (notasVal) notasVal.innerText = value.toLocaleString('pt-BR');

                // 1. Processo Manual: 3 min por nota
                const horas = value / 20;
                if (manualHours) manualHours.innerText = horas.toLocaleString('pt-BR', { maximumFractionDigits: 1 });
                
                const custoManualNum = horas * 16;
                if (manualCost) {
                    manualCost.innerText = custoManualNum.toLocaleString('pt-BR', { 
                        style: 'currency', 
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2 
                    });
                }

                // 2. Nota Fácil (Planos SSOT)
                let plano = "Free";
                let custoPlano = 0;
                if (value <= 100) {
                    plano = "Free";
                    custoPlano = 0;
                } else if (value <= 500) {
                    plano = "Starter";
                    custoPlano = 39.90;
                } else if (value <= 1500) {
                    plano = "Crescimento";
                    custoPlano = 89.90;
                } else {
                    plano = "Scale";
                    custoPlano = 199.90;
                }

                if (planCost) {
                    planCost.innerText = custoPlano === 0 ? "Grátis" : custoPlano.toLocaleString('pt-BR', { 
                        style: 'currency', 
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2 
                    });
                }
                if (planName) planName.innerText = plano;

                // 3. Economia e ROI
                const economiaMensal = custoManualNum - custoPlano;
                const economiaAnual = economiaMensal * 12;
                
                if (savingsVal) {
                    savingsVal.innerText = economiaMensal.toLocaleString('pt-BR', { 
                        style: 'currency', 
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2 
                    });
                }
                if (savingsAnnual) {
                    savingsAnnual.innerText = economiaAnual.toLocaleString('pt-BR', { 
                        style: 'currency', 
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2 
                    });
                }

                if (roiVal) {
                    if (custoPlano === 0) {
                        roiVal.innerText = "Grátis (100% ROI)";
                    } else {
                        const roi = (economiaMensal / custoPlano) * 100;
                        roiVal.innerText = `+${Math.round(roi).toLocaleString('pt-BR')}%`;
                    }
                }

                // Atualizar classes dos presets
                const presetPequeno = document.querySelector('button[onclick="setSliderValue(400)"]');
                const presetMedio = document.getElementById('btn-preset-med');
                const presetGrande = document.querySelector('button[onclick="setSliderValue(3600)"]');

                if (presetPequeno) {
                    presetPequeno.className = value === 400 
                        ? "bg-blue-50 text-blue-600 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-blue-200 shadow-sm"
                        : "bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-slate-200 hover:border-blue-200";
                }
                if (presetMedio) {
                    presetMedio.className = value === 1500 
                        ? "bg-blue-50 text-blue-600 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-blue-200 shadow-sm"
                        : "bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-slate-200 hover:border-blue-200";
                }
                if (presetGrande) {
                    presetGrande.className = value === 3600 
                        ? "bg-blue-50 text-blue-600 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-blue-200 shadow-sm"
                        : "bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-slate-200 hover:border-blue-200";
                }
            }

            if (slider) {
                slider.addEventListener('input', (e) => {
                    updateCalculator(parseInt(e.target.value));
                });
                // Inicializar com 1.500 notas (Plano Crescimento recomendado)
                updateCalculator(1500);
            }
        });
    </script>


---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nota Fácil | Automação de NFS-e Nacional" description="Baixe Notas Fiscais de Serviço (NFSe) em lote de forma automática, direto na sua máquina, sem digitação manual." bodyClass="bg-slate-50 text-slate-900 overflow-x-hidden">

    <!-- Modal de Transição (Aha! Moment) -->
    <div id="store-modal" class="fixed inset-0 z-50 hidden bg-slate-900/80 backdrop-blur-sm flex items-center justify-center opacity-0 transition-opacity duration-300">
        <div class="bg-white p-10 rounded-[2.5rem] shadow-2xl max-w-lg w-full text-center transform scale-95 transition-transform duration-300 relative border border-slate-200" id="store-modal-content">
            <button onclick="closeModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 transition-colors">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
            <div class="w-20 h-20 bg-blue-50 text-blue-600 rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-inner">
                <i data-lucide="shield-check" class="w-10 h-10"></i>
            </div>
            <h3 class="text-3xl font-black text-slate-900 mb-4 tracking-tight">Instalação segura em andamento</h3>
            <p class="text-lg text-slate-600 font-medium mb-8 leading-relaxed">Clique em <strong class="text-slate-900 bg-slate-100 px-2 py-1 rounded">Abrir</strong> na janela pop-up do seu Windows para iniciar a instalação certificada.</p>
            <div class="w-12 h-12 border-4 border-blue-100 border-t-blue-600 rounded-full animate-spin mx-auto"></div>
        </div>
    </div>

    <!-- Bloco 1: O PORQUÊ (Hero Section) -->
    <section id="hero" class="hero-gradient pt-32 pb-32 lg:pt-48 relative overflow-hidden bg-slate-900">
        <div class="absolute top-0 left-0 w-full h-full opacity-20 pointer-events-none overflow-hidden">
            <div class="absolute -top-32 -right-32 w-[600px] h-[600px] bg-blue-600 rounded-full blur-[150px] will-change-transform"></div>
            <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] bg-indigo-600 rounded-full blur-[150px] will-change-transform"></div>
        </div>

        <div class="container mx-auto px-6 relative z-10 text-center">
            <div class="max-w-4xl mx-auto" data-aos="fade-up">
                   <!-- Badge Novidade -->
                <a href="/atualizacao/" class="inline-flex items-center gap-2 bg-red-500/10 text-red-400 border border-red-500/30 font-black px-4 py-1.5 rounded-full text-xs uppercase tracking-widest mb-8 hover:bg-red-500/20 transition-colors">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                    Novidade: Motor v3.3.4 supera o hCaptcha + Dashboard Fiscal no Excel!
                </a>

                <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-white leading-tight mb-8 tracking-tight">
                    Enquanto o Portal Nacional bloqueia a sua equipe, <br class="hidden lg:block"/><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">o Nota Fácil automatiza o seu fechamento.</span>
                </h1>
                
                <p class="text-xl lg:text-2xl text-slate-300 leading-relaxed mb-12 max-w-3xl mx-auto font-medium">
                    Esqueça a digitação manual, a lentidão do governo e os novos bloqueios visuais. O primeiro robô desktop homologado pela Microsoft baixa XMLs e PDFs em lote, organiza nas suas pastas e gera planilhas prontas para o seu ERP.
                </p>

                <div class="flex flex-col items-center gap-6">
                    <a href="ms-windows-store://pdp/?productid=9N4GBNDFL550" 
                       target="_blank"
                       onclick="openStoreModal(); window.dataLayer = window.dataLayer || []; window.dataLayer.push({'event': 'download_store'});"
                       class="group relative inline-flex items-center justify-center gap-4 bg-white text-slate-900 px-10 py-6 sm:px-12 sm:py-7 rounded-2xl font-black transition-all shadow-[0_20px_50px_rgba(37,99,235,0.2)] hover:scale-105 active:scale-95 text-xl sm:text-2xl uppercase tracking-wider overflow-hidden">
                         <div class="absolute inset-0 bg-gradient-to-r from-blue-100 to-indigo-100 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                         <i data-lucide="shopping-bag" class="w-8 h-8 text-blue-600 relative z-10"></i>
                         <span class="relative z-10">Baixar Versão com Motor Ghost</span>
                    </a>
                    <p class="text-slate-400 font-medium flex items-center gap-2 text-sm sm:text-base">
                        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i>
                        App homologado pela Microsoft. Instalação limpa em 1 clique.
                    </p>
                </div>

                <div class="mt-16 pt-8 border-t border-white/10">
                    <a href="https://notafacildownloader.contabilcert.com.br/instalar-nota-facil" 
                       target="_blank"
                       onclick="window.dataLayer = window.dataLayer || []; window.dataLayer.push({'event': 'download_exe'});"
                       class="text-slate-400 hover:text-white transition-colors underline decoration-slate-600 underline-offset-4 text-sm font-medium">
                        Usa sistema legado? Baixe o instalador clássico .exe
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Bloco 2: A Tríade de Valor (O Core Business) -->
    <section class="py-24 bg-white relative z-20">
        <div class="container mx-auto px-6">
            <div class="text-center mb-20" data-aos="fade-up">
                <h2 class="text-4xl lg:text-5xl font-black text-slate-900 leading-tight">
                    Por que o Nota Fácil funciona onde as <span class="text-blue-600">plataformas em nuvem falham?</span>
                </h2>
            </div>

            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                <!-- Captura Blindada -->
                <div class="bg-slate-50 p-10 rounded-[2.5rem] border border-slate-200 hover:border-blue-300 transition-all shadow-sm hover:shadow-xl group" data-aos="fade-up" data-aos-delay="100">
                    <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="shield-alert" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">Captura Blindada</h3>
                    <p class="text-slate-600 leading-relaxed font-medium">O novo Motor Ghost supera bloqueios (hCaptcha) invisivelmente, enquanto a Sincronização NSU garante 100% de captura sem pular nenhuma nota da sequência.</p>
                </div>

                <!-- Processamento Local (LGPD) -->
                <div class="bg-slate-50 p-10 rounded-[2.5rem] border border-slate-200 hover:border-emerald-300 transition-all shadow-sm hover:shadow-xl group" data-aos="fade-up" data-aos-delay="200">
                    <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="server-off" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">Processamento Local</h3>
                    <p class="text-slate-600 leading-relaxed font-medium">Você não faz upload do maior patrimônio do cliente. O robô roda 100% no seu PC. O Certificado A1 nunca vai para nuvem, garantindo segurança total e adequação à LGPD.</p>
                </div>

                <!-- Dashboard & Inteligência -->
                <div class="bg-slate-50 p-10 rounded-[2.5rem] border border-slate-200 hover:border-purple-300 transition-all shadow-sm hover:shadow-xl group" data-aos="fade-up" data-aos-delay="300">
                    <div class="w-16 h-16 bg-purple-100 text-purple-600 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="line-chart" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">Dashboard & Inteligência</h3>
                    <p class="text-slate-600 leading-relaxed font-medium">Muito além de XMLs brutos. O robô compila suas notas em uma Planilha Mestra contendo um Dashboard completo com gráficos de faturamento, tomadas, retenções federais e auditoria cromática de status.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Bloco 3: O Elefante na Sala (Faixa de Choque hCaptcha) -->
    <section class="py-24 bg-red-600 relative overflow-hidden border-y-8 border-red-800">
        <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9IiNmZmYiLz48L3N2Zz4=')]"></div>
        <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-red-500 rounded-full blur-[100px]"></div>
        
        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12" data-aos="zoom-in">
                <div class="md:w-1/2">
                    <h2 class="text-3xl lg:text-5xl font-black text-white leading-tight mb-6">A nova regra do Governo parou o seu sistema web?</h2>
                    <p class="text-lg text-red-100 font-medium leading-relaxed border-l-4 border-red-400 pl-4">
                        A Receita Federal ativou o <strong>hCaptcha</strong> no Portal Nacional. Plataformas baseadas em nuvem sofrem e travam para contornar. Sendo um software nativo (desktop), o Nota Fácil processa o desafio diretamente na sua máquina, garantindo que o seu fluxo de trabalho não seja interrompido por telas de verificação.
                    </p>
                </div>
                <div class="md:w-1/2 w-full">
                    <div class="bg-slate-900 p-8 rounded-[2.5rem] shadow-2xl border border-slate-800 text-center">
                        <i data-lucide="bot" class="w-16 h-16 text-emerald-400 mx-auto mb-6"></i>
                        <h4 class="text-2xl font-black text-white mb-4">Motor Ghost Ativado</h4>
                        <p class="text-slate-400 mb-8">Navegação que simula o usuário real e resolve o bloqueio invisivelmente.</p>
                        <a href="/atualizacao/" class="block w-full bg-red-600 text-white py-4 rounded-xl font-black transition-all hover:bg-red-500 uppercase tracking-widest text-sm">
                            Veja a v3.3.4 em Ação
                        </a>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </section>

    <!-- Bloco 3.5: Calculadora de Economia e ROI (Comparativo com Assistente) -->
    <section class="py-24 bg-slate-50 border-y border-slate-200 relative overflow-hidden">
        <div class="container mx-auto px-6 relative z-10">
            <div class="text-center mb-16" data-aos="fade-up">
                <h2 class="text-4xl lg:text-5xl font-black text-slate-900 leading-tight mb-4">
                    Quanto custa o trabalho manual <span class="text-blue-600">vs. o Nota Fácil?</span>
                </h2>
                <p class="text-lg text-slate-600 font-medium max-w-2xl mx-auto">
                    Arraste o simulador abaixo para comparar o custo em horas de um auxiliar fiscal resolvendo captchas manualmente comparado ao investimento no robô.
                </p>
            </div>

            <div class="grid lg:grid-cols-12 gap-12 max-w-6xl mx-auto items-stretch">
                <!-- Coluna Esquerda: Controles -->
                <div class="lg:col-span-7 bg-white p-8 sm:p-12 rounded-[2.5rem] border border-slate-200 shadow-sm flex flex-col justify-between" data-aos="fade-right">
                    <div>
                        <div class="flex justify-between items-center mb-6">
                            <span class="text-slate-500 font-bold uppercase tracking-wider text-xs">Volume Mensal</span>
                            <div class="flex items-baseline">
                                <span class="text-blue-600 font-black text-3xl" id="calc-notas-val">1.500</span>
                                <span class="text-slate-400 font-bold text-sm ml-1">NFS-e / mês</span>
                            </div>
                        </div>

                        <!-- Slider -->
                        <div class="relative mb-8">
                            <input 
                                type="range" 
                                id="calc-slider" 
                                min="100" 
                                max="5000" 
                                step="100" 
                                value="1500" 
                                class="w-full h-3 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 focus:outline-none"
                            />
                            <div class="flex justify-between text-xs font-bold text-slate-400 mt-3 px-1">
                                <span>100</span>
                                <span>1.000</span>
                                <span>2.000</span>
                                <span>3.000</span>
                                <span>4.000</span>
                                <span>5.000</span>
                            </div>
                        </div>

                        <!-- Atalhos Rápidos -->
                        <div class="mb-8">
                            <span class="block text-slate-500 font-bold text-xs uppercase tracking-wider mb-3">Atalhos por Porte:</span>
                            <div class="flex flex-wrap gap-3">
                                <button 
                                    type="button"
                                    onclick="setSliderValue(400)" 
                                    class="bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-slate-200 hover:border-blue-200"
                                >
                                    Pequeno (400 notas)
                                </button>
                                <button 
                                    type="button"
                                    onclick="setSliderValue(1500)" 
                                    class="bg-blue-50 text-blue-600 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-blue-200"
                                    id="btn-preset-med"
                                >
                                    Médio (1.500 notas)
                                </button>
                                <button 
                                    type="button"
                                    onclick="setSliderValue(3600)" 
                                    class="bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-slate-200 hover:border-blue-200"
                                >
                                    Grande (3.600 notas)
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Premissas da Simulação -->
                    <div class="border-t border-slate-100 pt-6">
                        <h4 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                            <i data-lucide="info" class="w-3.5 h-3.5"></i> Premissas do cálculo:
                        </h4>
                        <p class="text-xs text-slate-500 leading-relaxed font-medium">
                            Calculado com base em um custo médio de folha de R$ 16,00/hora por assistente fiscal (~R$ 2.800/mês incluindo encargos) e estimativa conservadora de 3 minutos por NFS-e para download manual, resolução de captchas com movimento e organização de pastas.
                        </p>
                    </div>
                </div>

                <!-- Coluna Direita: Resultados -->
                <div class="lg:col-span-5 flex flex-col gap-6" data-aos="fade-left">
                    <!-- Card 1: Processo Manual -->
                    <div class="bg-white p-6 rounded-[2rem] border border-slate-200 shadow-sm flex items-start gap-4">
                        <div class="w-12 h-12 bg-red-50 text-red-500 rounded-xl flex items-center justify-center shrink-0">
                            <i data-lucide="user-x" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="text-slate-500 font-bold uppercase tracking-wider text-[11px]">Processo Manual (Assistente)</span>
                            <div class="mt-1 flex items-baseline gap-1">
                                <span class="text-2xl font-black text-slate-900" id="calc-manual-cost">R$ 1.200,00</span>
                                <span class="text-slate-400 font-semibold text-xs">/mês</span>
                            </div>
                            <span class="text-xs text-red-600 font-semibold mt-1 block flex items-center gap-1">
                                <i data-lucide="clock" class="w-3.5 h-3.5"></i> Desperdiça <strong id="calc-manual-hours">75</strong> horas no portal
                            </span>
                        </div>
                    </div>

                    <!-- Card 2: Nota Fácil -->
                    <div class="bg-white p-6 rounded-[2rem] border border-slate-200 shadow-sm flex items-start gap-4">
                        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center shrink-0">
                            <i data-lucide="cpu" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="text-slate-500 font-bold uppercase tracking-wider text-[11px]">Com Nota Fácil Downloader</span>
                            <div class="mt-1 flex items-baseline gap-1">
                                <span class="text-2xl font-black text-slate-900" id="calc-plan-cost">R$ 89,90</span>
                                <span class="text-slate-400 font-semibold text-xs">/mês</span>
                            </div>
                            <span class="text-xs text-emerald-600 font-semibold mt-1 block flex items-center gap-1">
                                <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> Plano: <strong id="calc-plan-name">Crescimento</strong> (CNPJs ilimitados)
                            </span>
                        </div>
                    </div>

                    <!-- Card 3: Economia Destacada (ROI) -->
                    <div class="bg-gradient-to-br from-indigo-900 to-slate-900 p-8 rounded-[2.5rem] border border-indigo-950 text-white shadow-xl flex-grow flex flex-col justify-between relative overflow-hidden">
                        <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-indigo-500/10 rounded-full blur-2xl"></div>
                        <div class="relative z-10">
                            <span class="text-indigo-300 font-bold uppercase tracking-wider text-[11px] bg-indigo-500/20 px-2.5 py-1 rounded-full">Economia Garantida</span>
                            <div class="mt-4">
                                <span class="text-slate-400 text-xs font-medium block">Sua economia líquida:</span>
                                <div class="flex items-baseline gap-1 mt-1">
                                    <span class="text-3xl sm:text-4xl font-black text-white" id="calc-savings-val">R$ 1.110,10</span>
                                    <span class="text-indigo-300 text-xs">/mês</span>
                                </div>
                            </div>
                            
                            <div class="mt-4 flex gap-4 text-xs font-semibold text-indigo-200">
                                <div>
                                    <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wide">Anual</span>
                                    <span class="text-white font-bold" id="calc-savings-annual">R$ 13.321,20</span>
                                </div>
                                <div class="border-l border-white/10 pl-4">
                                    <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wide">Retorno (ROI)</span>
                                    <span class="text-emerald-400 font-black text-sm" id="calc-roi-val">+1.235%</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-8 relative z-10">
                            <a href="ms-windows-store://pdp/?productid=9N4GBNDFL550" 
                               target="_blank"
                               onclick="openStoreModal()"
                               class="w-full bg-blue-600 hover:bg-blue-500 text-white text-center py-4 rounded-xl font-bold transition-all text-sm uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg shadow-blue-500/20"
                            >
                                <i data-lucide="download" class="w-4 h-4"></i> Eliminar Custos Ocultos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bloco 4: Escala e Performance -->
    <section class="py-24 bg-slate-900 relative overflow-hidden">
        <div class="container mx-auto px-6 relative z-10">
            <div class="text-center mb-20" data-aos="fade-up">
                <h2 class="text-4xl lg:text-5xl font-black text-white leading-tight">Projetado para escritórios <br/>que não param de crescer</h2>
            </div>

            <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
                <div class="bg-white/5 backdrop-blur-lg border border-white/10 p-12 rounded-[3rem]" data-aos="fade-right">
                    <div class="w-16 h-16 bg-blue-500/20 text-blue-400 rounded-2xl flex items-center justify-center mb-8">
                        <i data-lucide="building-2" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-3xl font-black text-white mb-6">CNPJs Ilimitados de Verdade</h3>
                    <p class="text-slate-300 text-lg leading-relaxed font-medium">Gerencie 5, 50 ou 500 empresas no mesmo painel. Nós não penalizamos o crescimento do seu escritório cobrando "por CNPJ". Adicione novos clientes à vontade.</p>
                </div>

                <div class="bg-white/5 backdrop-blur-lg border border-white/10 p-12 rounded-[3rem]" data-aos="fade-left">
                    <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-2xl flex items-center justify-center mb-8">
                        <i data-lucide="zap" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-3xl font-black text-white mb-6">Geração de PDF Instantânea</h3>
                    <p class="text-slate-300 text-lg leading-relaxed font-medium">Não dependa do servidor do governo para gerar o PDF da nota. Nosso motor renderiza os PDFs localmente a partir do XML em milissegundos. Alta performance no seu HD.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Bloco 5: Segurança Microsoft -->
    <section class="py-24 bg-white border-t border-slate-100">
        <div class="container mx-auto px-6">
            <div class="flex flex-col lg:flex-row items-center gap-16 max-w-6xl mx-auto">
                <div class="lg:w-1/2" data-aos="fade-right">
                    <div class="w-20 h-20 bg-blue-50 text-blue-600 rounded-3xl flex items-center justify-center mb-8 shadow-inner border border-blue-100">
                        <i data-lucide="award" class="w-10 h-10"></i>
                    </div>
                    <h2 class="text-4xl lg:text-5xl font-black text-slate-900 leading-tight mb-6">Auditado e Distribuído pela Microsoft Store</h2>
                    <p class="text-lg text-slate-600 leading-relaxed font-medium mb-8">
                        Você não precisa lidar com instaladores suspeitos ou telas vermelhas do Windows Defender. O Nota Fácil passou por rigorosa auditoria de segurança da Microsoft e está disponível na loja oficial do Windows 10 e 11.
                    </p>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3 text-slate-700 font-bold">
                            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-500"></i> Instalação limpa em um clique.
                        </li>
                        <li class="flex items-center gap-3 text-slate-700 font-bold">
                            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-500"></i> Sem conflitos com o Antivírus corporativo.
                        </li>
                        <li class="flex items-center gap-3 text-slate-700 font-bold">
                            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-500"></i> Atualizações automáticas em segundo plano.
                        </li>
                    </ul>
                </div>
                <div class="lg:w-1/2 w-full bg-slate-50 p-10 sm:p-16 rounded-[3.5rem] border border-slate-200 text-center shadow-lg" data-aos="fade-left">
                    <i data-lucide="lock" class="w-12 h-12 text-slate-400 mx-auto mb-6"></i>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">Segurança Fiscal Comprovada</h3>
                    <p class="text-slate-500 mb-8">Software construído para garantir o sigilo contábil exigido por lei.</p>
                    <a href="ms-windows-store://pdp/?productid=9N4GBNDFL550" onclick="openStoreModal()" class="inline-flex items-center justify-center gap-3 bg-blue-600 text-white px-8 py-4 rounded-2xl font-black hover:bg-blue-700 transition w-full shadow-lg hover:shadow-blue-500/30">
                        <i data-lucide="download" class="w-5 h-5"></i>
                        BAIXAR NA LOJA WINDOWS
                    </a>

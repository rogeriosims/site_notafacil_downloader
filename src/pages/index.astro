                    {postsCaptcha.map((post: any, i: number) => (
                        <a href={`/blog/${post.id}/`} class="group bg-white p-8 rounded-[2rem] border border-slate-200 hover:border-blue-200 shadow-sm hover:shadow-lg transition-all flex flex-col gap-4" data-aos="fade-up" data-aos-delay={100 + i * 100}>
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">{post.data.pubDate.toLocaleDateString('pt-BR')}</span>
                            <h3 class="text-lg font-black text-slate-800 leading-tight group-hover:text-blue-600 transition-colors">{post.data.title}</h3>
                            <p class="text-sm text-slate-500 line-clamp-3 leading-relaxed">{post.data.description}</p>
                            <span class="text-blue-600 font-bold text-xs mt-auto pt-2 group-hover:translate-x-1 transition-transform inline-block">Ler artigo &rarr;</span>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- Scripts de Interação (Client-side) -->
    <script is:inline>
        function isValidCNPJ(cnpj) {
            cnpj = cnpj.replace(/[^\d]+/g, '');
            if (cnpj == '' || cnpj.length != 14) return false;
            if (/^(\d)\1+$/.test(cnpj)) return false; // Elimina sequências repetidas (00..., 11..., etc)

            let tamanho = cnpj.length - 2
            let numeros = cnpj.substring(0, tamanho);
            let digitos = cnpj.substring(tamanho);
            let soma = 0;
            let pos = tamanho - 7;
            for (let i = tamanho; i >= 1; i--) {
                soma += numeros.charAt(tamanho - i) * pos--;
                if (pos < 2) pos = 9;
            }
            let resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
            if (resultado != digitos.charAt(0)) return false;

            tamanho = tamanho + 1;
            numeros = cnpj.substring(0, tamanho);
            soma = 0;
            pos = tamanho - 7;
            for (let i = tamanho; i >= 1; i--) {
                soma += numeros.charAt(tamanho - i) * pos--;
                if (pos < 2) pos = 9;
            }
            resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
            if (resultado != digitos.charAt(1)) return false;

            return true;
        }

        function isValidPhone(phone) {
            phone = phone.replace(/[^\d]+/g, '');
            if (phone.length < 10 || phone.length > 11) return false;
            if (/^(\d)\1+$/.test(phone)) return false; // Elimina sequências repetidas
            if (phone.charAt(0) === '0') return false; // DDD não começa com 0
            if (phone.substring(0, 2) === '00') return false;
            return true;
        }

        // Calculadora de ROI — exposta para os botões de atalho
        window.setSliderValue = function(val) {
            const slider = document.getElementById('calc-slider');
            if (slider) {
                slider.value = val.toString();
                slider.dispatchEvent(new Event('input'));
            }
        };

        document.addEventListener('DOMContentLoaded', function () {
            // Máscaras de entrada
            if (typeof IMask !== 'undefined') {
                const elWhats = document.getElementById('whatsapp');
                const elCnpj = document.getElementById('cnpj');
                if (elWhats) IMask(elWhats, { mask: '(00) 00000-0000' });
                if (elCnpj) IMask(elCnpj, { mask: '00.000.000/0000-00' });
            }

            // ----- Calculadora de ROI -----
            const slider = document.getElementById('calc-slider');
            const notasVal = document.getElementById('calc-notas-val');
            const manualCost = document.getElementById('calc-manual-cost');
            const manualHours = document.getElementById('calc-manual-hours');
            const planCost = document.getElementById('calc-plan-cost');
            const planName = document.getElementById('calc-plan-name');
            const savingsVal = document.getElementById('calc-savings-val');
            const savingsAnnual = document.getElementById('calc-savings-annual');
            const roiVal = document.getElementById('calc-roi-val');

            function updateCalculator(value) {
                if (notasVal) notasVal.innerText = value.toLocaleString('pt-BR');

                // 1. Processo Manual: 3 min por nota
                const horas = value / 20;
                if (manualHours) manualHours.innerText = horas.toLocaleString('pt-BR', { maximumFractionDigits: 1 });

                const custoManualNum = horas * 16;
                if (manualCost) {
                    manualCost.innerText = custoManualNum.toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }

                // 2. Nota Fácil (Planos SSOT)
                let plano = "Free";
                let custoPlano = 0;
                if (value <= 100) {
                    plano = "Free";
                    custoPlano = 0;
                } else if (value <= 500) {
                    plano = "Starter";
                    custoPlano = 39.90;
                } else if (value <= 1500) {
                    plano = "Crescimento";
                    custoPlano = 89.90;
                } else {
                    plano = "Scale";
                    custoPlano = 199.90;
                }

                if (planCost) {
                    planCost.innerText = custoPlano === 0 ? "Grátis" : custoPlano.toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
                if (planName) planName.innerText = plano;

                // 3. Economia e ROI
                const economiaMensal = custoManualNum - custoPlano;
                const economiaAnual = economiaMensal * 12;

                if (savingsVal) {
                    savingsVal.innerText = economiaMensal.toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
                if (savingsAnnual) {
                    savingsAnnual.innerText = economiaAnual.toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }

                if (roiVal) {
                    if (custoPlano === 0) {
                        roiVal.innerText = "Grátis (100% ROI)";
                    } else {
                        const roi = (economiaMensal / custoPlano) * 100;
                        roiVal.innerText = `+${Math.round(roi).toLocaleString('pt-BR')}%`;
                    }
                }

                // Atualizar classes dos presets
                const presetPequeno = document.querySelector('button[onclick="setSliderValue(400)"]');
                const presetMedio = document.getElementById('btn-preset-med');
                const presetGrande = document.querySelector('button[onclick="setSliderValue(3600)"]');

                const classAtivo = "bg-blue-50 text-blue-600 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-blue-200 shadow-sm";
                const classInativo = "bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-slate-200 hover:border-blue-200";

                if (presetPequeno) presetPequeno.className = value === 400 ? classAtivo : classInativo;
                if (presetMedio) presetMedio.className = value === 1500 ? classAtivo : classInativo;
                if (presetGrande) presetGrande.className = value === 3600 ? classAtivo : classInativo;
            }

            if (slider) {
                slider.addEventListener('input', (e) => {
                    updateCalculator(parseInt(e.target.value));
                });
                // Inicializar com 1.500 notas (Plano Crescimento recomendado)
                updateCalculator(1500);
            }

            // ----- Formulário de Ativação (captura de lead + GCLID) -----
            const heroForm = document.getElementById('hero-form');
            if (!heroForm) return;

            heroForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                const form = e.target;
                const btn = document.getElementById('btn-submit');
                const btnText = document.getElementById('btn-text');
                const originalText = btnText.innerHTML;

                const nome = document.getElementById('nome_completo').value.trim();
                const email = document.getElementById('email_profissional').value.trim();
                const whatsapp = document.getElementById('whatsapp').value;
                const cnpj = document.getElementById('cnpj').value;

                if (!nome || !email || !whatsapp || !cnpj) {
                    Swal.fire({
                        title: 'Dados Incompletos',
                        text: 'Por favor, preencha todos os campos do formulário.',
                        icon: 'warning',
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#3b82f6'
                    });
                    return;
                }

                if (!isValidPhone(whatsapp)) {
                    Swal.fire({
                        title: 'Telefone Inválido',
                        text: 'Por favor, insira um número de WhatsApp real.',
                        icon: 'warning',
                        confirmButtonText: 'Corrigir',
                        confirmButtonColor: '#3b82f6'
                    });
                    return;
                }

                if (!isValidCNPJ(cnpj)) {
                    Swal.fire({
                        title: 'CNPJ Inválido',
                        text: 'O CNPJ informado não é válido. Verifique os dados.',
                        icon: 'warning',
                        confirmButtonText: 'Corrigir',
                        confirmButtonColor: '#3b82f6'
                    });
                    return;
                }

                // Recuperar GCLID da URL ou do sessionStorage (gravado pelo BaseLayout)
                const gclid = sessionStorage.getItem('gclid') || (new URLSearchParams(window.location.search)).get('gclid');

                const payload = {
                    action: 'register',
                    nome: nome,
                    email: email,
                    whatsapp: whatsapp,
                    cnpj: cnpj,
                    gclid: gclid
                };

                try {
                    btn.disabled = true;
                    btn.classList.add('opacity-70', 'cursor-not-allowed');
                    btn.classList.remove('hover:-translate-y-1', 'active:scale-95');
                    btnText.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> PREPARANDO ACESSO...';
                    if (typeof lucide !== 'undefined') lucide.createIcons();

                    const response = await fetch('https://n8n.rockethub.com.br/webhook/17e601cd-2655-410f-b8af-4ffffd07bec0', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.status === 201 || response.ok) {
                        const responseDataText = await response.text();
                        let responseData;
                        try {
                            responseData = JSON.parse(responseDataText);
                        } catch (err) {
                            responseData = {};
                        }

                        // O webhook pode retornar um array de objetos
                        let responseObj = responseData;
                        if (Array.isArray(responseData) && responseData.length > 0) {
                            responseObj = responseData[0];
                        }

                        // Backend sinalizou erro lógico (ex: CNPJ/e-mail já cadastrado).
                        // Não é uma falha: o escritório já é cliente e quer baixar de novo.
                        if (responseObj && responseObj.status === 'error') {
                            Swal.fire({
                                title: 'Você já tem cadastro',
                                text: responseObj.message || 'Este CNPJ ou e-mail já possuem uma licença ativa.',
                                icon: 'info',
                                confirmButtonText: 'Baixar o robô novamente',
                                showCancelButton: true,
                                cancelButtonText: 'Voltar ao formulário',
                                confirmButtonColor: '#3b82f6',
                                cancelButtonColor: '#94a3b8'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // Marca o retorno para /obrigado/ ajustar a mensagem
                                    sessionStorage.setItem('notafacil_user_data', JSON.stringify({
                                        nome: nome,
                                        email: email,
                                        returning: true
                                    }));
                                    // Evento separado: retorno não é lead novo e não deve
                                    // contar como conversão no Ads.
                                    window.dataLayer = window.dataLayer || [];
                                    window.dataLayer.push({ 'event': 'download_recorrente' });
                                    window.location.href = '/obrigado/';
                                }
                            });
                            return;
                        }

                        // Conversão: lead qualificado gerado
                        window.dataLayer = window.dataLayer || [];
                        window.dataLayer.push({ 'event': 'lead_cadastro', 'has_gclid': !!gclid });

                        // Dados usados na página de boas-vindas (/obrigado/)
                        sessionStorage.setItem('notafacil_user_data', JSON.stringify(responseObj));

                        form.reset();
                        window.location.href = '/obrigado/';

                    } else {
                        throw new Error('Erro na requisição');
                    }

                } catch (error) {
                    console.error('Erro:', error);
                    Swal.fire({
                        title: 'Ops!',
                        text: 'Ocorreu um erro ao processar seu cadastro. Tente novamente.',
                        icon: 'error',
                        confirmButtonText: 'Fechar',
                        confirmButtonColor: '#ef4444'
                    });
                } finally {
                    btn.disabled = false;
                    btn.classList.remove('opacity-70', 'cursor-not-allowed');
                    btn.classList.add('hover:-translate-y-1', 'active:scale-95');
                    btnText.innerHTML = originalText;
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                }
            });
        });
    </script>

</BaseLayout>

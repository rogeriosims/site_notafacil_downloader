    <!-- Scripts de Interação (Client-side) -->
    <script is:inline>
        function isValidCNPJ(cnpj) {
            cnpj = cnpj.replace(/[^\d]+/g, '');
            if (cnpj == '' || cnpj.length != 14) return false;
            if (/^(\d)\1+$/.test(cnpj)) return false; // Elimina sequências repetidas (00..., 11..., etc)

            let tamanho = cnpj.length - 2
            let numeros = cnpj.substring(0, tamanho);
            let digitos = cnpj.substring(tamanho);
            let soma = 0;
            let pos = tamanho - 7;
            for (let i = tamanho; i >= 1; i--) {
                soma += numeros.charAt(tamanho - i) * pos--;
                if (pos < 2) pos = 9;
            }
            let resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
            if (resultado != digitos.charAt(0)) return false;

            tamanho = tamanho + 1;
            numeros = cnpj.substring(0, tamanho);
            soma = 0;
            pos = tamanho - 7;
            for (let i = tamanho; i >= 1; i--) {
                soma += numeros.charAt(tamanho - i) * pos--;
                if (pos < 2) pos = 9;
            }
            resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
            if (resultado != digitos.charAt(1)) return false;

            return true;
        }

        function isValidPhone(phone) {
            phone = phone.replace(/[^\d]+/g, '');
            if (phone.length < 10 || phone.length > 11) return false;
            if (/^(\d)\1+$/.test(phone)) return false; // Elimina sequências repetidas
            if (phone.charAt(0) === '0') return false; // DDD não começa com 0
            if (phone.substring(0, 2) === '00') return false;
            return true;
        }

        // Calculadora de ROI — exposta para os botões de atalho
        window.setSliderValue = function(val) {
            const slider = document.getElementById('calc-slider');
            if (slider) {
                slider.value = val.toString();
                slider.dispatchEvent(new Event('input'));
            }
        };

        document.addEventListener('DOMContentLoaded', function () {
            // Máscaras de entrada
            if (typeof IMask !== 'undefined') {
                const elWhats = document.getElementById('whatsapp');
                const elCnpj = document.getElementById('cnpj');
                if (elWhats) IMask(elWhats, { mask: '(00) 00000-0000' });
                if (elCnpj) IMask(elCnpj, { mask: '00.000.000/0000-00' });
            }

            // ----- Calculadora de ROI -----
            const slider = document.getElementById('calc-slider');
            const notasVal = document.getElementById('calc-notas-val');
            const manualCost = document.getElementById('calc-manual-cost');
            const manualHours = document.getElementById('calc-manual-hours');
            const planCost = document.getElementById('calc-plan-cost');
            const planName = document.getElementById('calc-plan-name');
            const savingsVal = document.getElementById('calc-savings-val');
            const savingsAnnual = document.getElementById('calc-savings-annual');
            const roiVal = document.getElementById('calc-roi-val');

            function updateCalculator(value) {
                if (notasVal) notasVal.innerText = value.toLocaleString('pt-BR');

                // 1. Processo Manual: 2 min por nota (mesma premissa do bloco de números e do SSOT)
                const horas = value / 30;
                if (manualHours) manualHours.innerText = horas.toLocaleString('pt-BR', { maximumFractionDigits: 1 });

                const custoManualNum = horas * 16;
                if (manualCost) {
                    manualCost.innerText = custoManualNum.toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }

                // 2. Nota Fácil (Planos SSOT)
                let plano = "Free";
                let custoPlano = 0;
                if (value <= 100) {
                    plano = "Free";
                    custoPlano = 0;
                } else if (value <= 500) {
                    plano = "Starter";
                    custoPlano = 39.90;
                } else if (value <= 1500) {
                    plano = "Crescimento";
                    custoPlano = 89.90;
                } else {
                    plano = "Scale";
                    custoPlano = 199.90;
                }

                if (planCost) {
                    planCost.innerText = custoPlano === 0 ? "Grátis" : custoPlano.toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
                if (planName) planName.innerText = plano;

                // 3. Economia e ROI
                const economiaMensal = custoManualNum - custoPlano;
                const economiaAnual = economiaMensal * 12;

                if (savingsVal) {
                    savingsVal.innerText = economiaMensal.toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
                if (savingsAnnual) {
                    savingsAnnual.innerText = economiaAnual.toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }

                if (roiVal) {
                    if (custoPlano === 0) {
                        roiVal.innerText = "Sem custo";
                    } else {
                        const roi = (economiaMensal / custoPlano) * 100;
                        roiVal.innerText = `+${Math.round(roi).toLocaleString('pt-BR')}%`;
                    }
                }

                // Atualizar classes dos presets
                const presetPequeno = document.querySelector('button[onclick="setSliderValue(400)"]');
                const presetMedio = document.getElementById('btn-preset-med');
                const presetGrande = document.querySelector('button[onclick="setSliderValue(3600)"]');

                const classAtivo = "bg-blue-50 text-blue-600 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-blue-200 shadow-sm";
                const classInativo = "bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all border border-slate-200 hover:border-blue-200";

                if (presetPequeno) presetPequeno.className = value === 400 ? classAtivo : classInativo;
                if (presetMedio) presetMedio.className = value === 1500 ? classAtivo : classInativo;
                if (presetGrande) presetGrande.className = value === 3600 ? classAtivo : classInativo;
            }

            if (slider) {
                slider.addEventListener('input', (e) => {
                    updateCalculator(parseInt(e.target.value));
                });
                // Inicializar com 1.500 notas (Plano Crescimento recomendado)
                updateCalculator(1500);
            }

            // ----- Formulário de Ativação (captura de lead + GCLID) -----
            const heroForm = document.getElementById('hero-form');
            if (!heroForm) return;

            heroForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                const form = e.target;
                const btn = document.getElementById('btn-submit');
                const btnText = document.getElementById('btn-text');
                const originalText = btnText.innerHTML;

                const nome = document.getElementById('nome_completo').value.trim();
                const email = document.getElementById('email_profissional').value.trim();
                const whatsapp = document.getElementById('whatsapp').value;
                const cnpj = document.getElementById('cnpj').value;

                if (!nome || !email || !whatsapp || !cnpj) {
                    Swal.fire({
                        title: 'Dados Incompletos',
                        text: 'Por favor, preencha todos os campos do formulário.',
                        icon: 'warning',
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#3b82f6'
                    });
                    return;
                }

                if (!isValidPhone(whatsapp)) {
                    Swal.fire({
                        title: 'Telefone Inválido',
                        text: 'Por favor, insira um número de WhatsApp real.',
                        icon: 'warning',
                        confirmButtonText: 'Corrigir',
                        confirmButtonColor: '#3b82f6'
                    });
                    return;
                }

                if (!isValidCNPJ(cnpj)) {
                    Swal.fire({
                        title: 'CNPJ Inválido',
                        text: 'O CNPJ informado não é válido. Verifique os dados.',
                        icon: 'warning',
                        confirmButtonText: 'Corrigir',
                        confirmButtonColor: '#3b82f6'
                    });
                    return;
                }

                // Recuperação resiliente de GCLID (URL, localStorage, sessionStorage, cookie _gcl_aw, ou fallback iOS wbraid/gbraid)
                function getCookieValue(name) {
                    try {
                        const match = document.cookie.match(new RegExp('(^|;\\s*)' + name + '=([^;]*)'));
                        return match ? decodeURIComponent(match[2]) : null;
                    } catch (e) {
                        return null;
                    }
                }

                function getGoogleClickId() {
                    try {
                        const urlParams = new URLSearchParams(window.location.search);
                        // 1. URL direta
                        if (urlParams.get('gclid')) return urlParams.get('gclid');

                        // 2. localStorage persistente
                        if (localStorage.getItem('nfd_gclid')) return localStorage.getItem('nfd_gclid');

                        // 3. sessionStorage
                        if (sessionStorage.getItem('gclid')) return sessionStorage.getItem('gclid');

                        // 4. Cookie primário do Vinculador de Conversões do Google (_gcl_aw)
                        const gclAw = getCookieValue('_gcl_aw');
                        if (gclAw) {
                            const parts = gclAw.split('.');
                            if (parts.length >= 3) return parts.slice(2).join('.');
                            return gclAw;
                        }

                        // 5. Fallback para iOS / Safari (wbraid ou gbraid)
                        const wbraid = urlParams.get('wbraid') || localStorage.getItem('nfd_wbraid') || sessionStorage.getItem('wbraid');
                        if (wbraid) return wbraid;

                        const gbraid = urlParams.get('gbraid') || localStorage.getItem('nfd_gbraid') || sessionStorage.getItem('gbraid');
                        if (gbraid) return gbraid;
                    } catch (e) {}
                    return null;
                }

                const gclid = getGoogleClickId();
                const urlParams = new URLSearchParams(window.location.search);
                const wbraid = urlParams.get('wbraid') || localStorage.getItem('nfd_wbraid') || sessionStorage.getItem('wbraid');
                const gbraid = urlParams.get('gbraid') || localStorage.getItem('nfd_gbraid') || sessionStorage.getItem('gbraid');

                const payload = {
                    action: 'register',
                    nome: nome,
                    email: email,
                    whatsapp: whatsapp,
                    cnpj: cnpj,
                    gclid: gclid,
                    wbraid: wbraid,
                    gbraid: gbraid
                };

                try {
                    btn.disabled = true;
                    btn.classList.add('opacity-70', 'cursor-not-allowed');
                    btn.classList.remove('hover:-translate-y-1', 'active:scale-95');
                    btnText.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> PREPARANDO ACESSO...';
                    if (typeof lucide !== 'undefined') lucide.createIcons();

                    let response;
                    try {
                        // 1. Tenta via proxy local Cloudflare (Same-Origin: sem preflight CORS, imune a bloqueios de firewall/adblocker)
                        response = await fetch('/api/cadastro', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                    } catch (proxyErr) {
                        console.warn('Proxy local indisponível, tentando webhook direto:', proxyErr);
                        // 2. Fallback direto caso o proxy local falhe
                        response = await fetch('https://n8n.rockethub.com.br/webhook/17e601cd-2655-410f-b8af-4ffffd07bec0', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                    }

                    // Lê o payload independentemente do código HTTP retornado (200, 201, 409, 400, etc.)
                    const responseDataText = await response.text();
                    let responseData = {};
                    try {
                        responseData = JSON.parse(responseDataText);
                    } catch (err) {
                        responseData = {};
                    }

                    // O webhook pode retornar um array de objetos ou um objeto direto
                    let responseObj = responseData;
                    if (Array.isArray(responseData) && responseData.length > 0) {
                        responseObj = responseData[0];
                    }

                    const isDuplicatedOrActive =
                        response.status === 409 ||
                        (responseObj && (
                            responseObj.status === 'error' ||
                            responseObj.authorized === 'false' ||
                            responseObj.authorized === false ||
                            (typeof responseObj.message === 'string' && (
                                responseObj.message.includes('já possuem cadastro') ||
                                responseObj.message.includes('cadastro ativo') ||
                                responseObj.message.includes('já cadastrado') ||
                                responseObj.message.includes('já possui')
                            ))
                        ));

                    // CASO 1: Usuário / CNPJ já cadastrado
                    // Não é uma falha: o escritório já é cliente e quer baixar novamente ou instalar em outra máquina.
                    if (isDuplicatedOrActive) {
                        const mensagem = (responseObj && responseObj.message)
                            ? responseObj.message
                            : 'Identificamos que seu escritório já possui uma licença ativa. Seu e-mail cadastrado é a chave de ativação.';

                        Swal.fire({
                            title: 'Você já possui cadastro!',
                            text: mensagem,
                            icon: 'info',
                            showCancelButton: true,
                            confirmButtonText: 'Baixar o Robô Novamente',
                            cancelButtonText: 'Falar no WhatsApp',
                            confirmButtonColor: '#2563eb',
                            cancelButtonColor: '#10b981'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // Marca o retorno para /obrigado/ personalizar a saudação
                                sessionStorage.setItem('notafacil_user_data', JSON.stringify({
                                    nome: nome,
                                    email: email,
                                    cnpj: cnpj,
                                    returning: true
                                }));
                                // Evento de download recorrente (não infla conversão de lead novo no Ads)
                                window.dataLayer = window.dataLayer || [];
                                window.dataLayer.push({ 'event': 'download_recorrente' });
                                window.location.href = '/obrigado/';
                            } else if (result.dismiss === Swal.DismissReason.cancel) {
                                const msgWa = encodeURIComponent(`Olá! Já possuo cadastro com o e-mail ${email} e CNPJ ${cnpj}, mas preciso de ajuda com minha licença do Nota Fácil.`);
                                window.open(`https://wa.me/5531936184267?text=${msgWa}`, '_blank');
                            }
                        });
                        return;
                    }

                    // CASO 2: Sucesso total (Novo lead / 200 / 201)
                    if (response.ok || response.status === 201) {
                        sessionStorage.setItem('notafacil_user_data', JSON.stringify(responseObj || {
                            nome: nome,
                            email: email,
                            cnpj: cnpj
                        }));
                        form.reset();

                        let jaNavegou = false;
                        const irParaObrigado = () => {
                            if (jaNavegou) return;
                            jaNavegou = true;
                            window.location.href = '/obrigado/';
                        };

                        window.dataLayer = window.dataLayer || [];
                        window.dataLayer.push({
                            'event': 'lead_cadastro',
                            'has_gclid': !!gclid,
                            'gclid': gclid,
                            'wbraid': wbraid,
                            'gbraid': gbraid,
                            'eventCallback': irParaObrigado,
                            'eventTimeout': 2000
                        });

                        // Rede de segurança se o GTM não responder a tempo
                        setTimeout(irParaObrigado, 2100);
                        return;
                    }

                    // CASO 3: Erro de validação específico retornado pelo n8n (HTTP 400, 422, etc.)
                    if (responseObj && responseObj.message) {
                        Swal.fire({
                            title: 'Atenção aos Dados',
                            text: responseObj.message,
                            icon: 'warning',
                            confirmButtonText: 'Revisar Informações',
                            confirmButtonColor: '#3b82f6'
                        });
                        return;
                    }

                    // CASO 4: Falha genérica na resposta
                    throw new Error('Não foi possível processar a requisição.');

                } catch (error) {
                    console.error('Erro no envio do formulário:', error);
                    Swal.fire({
                        title: 'Instabilidade Temporária',
                        text: 'Tivemos uma instabilidade ao conectar ao servidor. Você pode tentar novamente ou falar diretamente com nosso suporte pelo WhatsApp.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Tentar Novamente',
                        cancelButtonText: 'Chamar no WhatsApp',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#10b981'
                    }).then((result) => {
                        if (result.dismiss === Swal.DismissReason.cancel) {
                            const msgWa = encodeURIComponent(`Olá! Tive uma instabilidade ao me cadastrar no site (E-mail: ${email}, CNPJ: ${cnpj}) e gostaria de ajuda para liberar meu acesso ao Nota Fácil.`);
                            window.open(`https://wa.me/5531936184267?text=${msgWa}`, '_blank');
                        }
                    });
                } finally {
                    btn.disabled = false;
                    btn.classList.remove('opacity-70', 'cursor-not-allowed');
                    btn.classList.add('hover:-translate-y-1', 'active:scale-95');
                    btnText.innerHTML = originalText;
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                }
            });
        });
    </script>

</BaseLayout>

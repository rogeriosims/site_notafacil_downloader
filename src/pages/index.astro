---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import posterAnuncio from '../assets/video/anuncio-poster.jpg';

// Posts de apoio ao argumento de captcha/resiliência (prova editorial)
const slugsCaptcha = [
    'dois-captchas-por-nota-portal-nacional-nfse',
    'quanto-custa-captcha-portal-nfse-escritorio',
    'como-superar-captcha-portal-nacional',
];
const todosPosts = await getCollection('blog');
const postsCaptcha = slugsCaptcha
    .map(slug => todosPosts.find(p => p.id === slug))
    .filter(Boolean);

// Prova operacional — base real de notas processadas pelo robô.
// Horas e jornadas são ESTIMATIVAS com a premissa única do site (calculadora e
// .agent/PRECOS-SSOT.md): 2 minutos de trabalho manual por nota (captchas do portal,
// download, organização e renomeação dos arquivos nas pastas).
const notasProcessadas = 175823; // atualizado em 18/09/2026
const MINUTOS_MANUAIS_POR_NOTA = 2;
const horasDevolvidas = Math.round((notasProcessadas * MINUTOS_MANUAIS_POR_NOTA) / 60);
const jornadasDevolvidas = Math.round(horasDevolvidas / 8);

const fmt = (n: number) => n.toLocaleString('pt-BR');
---

<BaseLayout title="Nota Fácil Downloader: Baixar NFS-e em Lote (XML e PDF)" description="Robô desktop que baixa XML e PDF da NFS-e Nacional em lote, com certificado A1, A3 ou login e senha. Roda no seu PC: o certificado não vai para a nuvem." bodyClass="bg-slate-50 text-slate-900 overflow-x-hidden">

    <!-- Bloco 1: HERO — Copy de resiliência + Formulário de ativação -->
    <section id="ativar" class="hero-gradient pt-32 pb-24 lg:pt-40 relative overflow-hidden bg-slate-900 scroll-mt-20">
        <div class="absolute top-0 left-0 w-full h-full opacity-20 pointer-events-none overflow-hidden">
            <div class="absolute -top-32 -right-32 w-[600px] h-[600px] bg-blue-600 rounded-full blur-[150px] will-change-transform"></div>
            <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] bg-indigo-600 rounded-full blur-[150px] will-change-transform"></div>
        </div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center max-w-7xl mx-auto">

                <!-- Coluna Esquerda: Argumento Central (Captcha / Resiliência) -->
                <div class="lg:col-span-7" data-aos="fade-right">
                    <span class="inline-flex items-center gap-2 bg-blue-500/10 text-blue-400 border border-blue-500/30 font-black px-4 py-1.5 rounded-full text-xs uppercase tracking-widest mb-8">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                        Software desktop para escritórios contábeis
                    </span>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-8 tracking-tight">
                        Baixe as NFS-e da <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">carteira inteira</span><br class="hidden lg:block"/> enquanto você faz outra coisa.
                    </h1>

                    <p class="text-lg lg:text-xl text-slate-300 leading-relaxed mb-10 max-w-2xl font-medium">
                        O robô entra no Portal Nacional por <strong class="text-white">certificado A1, A3 ou login e senha</strong>, baixa XML e PDF em lote e deixa tudo organizado nas pastas do seu ERP, com a planilha de conferência no fim. Ele roda no seu computador: o certificado dos seus clientes nunca sai dele.
                    </p>

                    <!-- Pilares rápidos de resiliência -->
                    <ul class="space-y-4 mb-4">
                        <li class="flex items-start gap-4 text-slate-200">
                            <i data-lucide="file-badge" class="w-6 h-6 text-emerald-400 shrink-0 mt-0.5"></i>
                            <span class="font-medium"><strong class="text-white font-black">Certificado A1, A3 ou login e senha.</strong> O robô usa os certificados instalados no Windows (A1 em arquivo ou A3 em token USB) e atende também quem só tem login.</span>
                        </li>
                        <li class="flex items-start gap-4 text-slate-200">
                            <i data-lucide="scan-eye" class="w-6 h-6 text-emerald-400 shrink-0 mt-0.5"></i>
                            <span class="font-medium"><strong class="text-white font-black">Captcha não trava o lote.</strong> Com certificado, a coleta usa a API oficial e nem passa por ele. No login e senha, o robô resolve os desafios localmente, em segundo plano.</span>
                        </li>
                        <li class="flex items-start gap-4 text-slate-200">
                            <i data-lucide="refresh-cw" class="w-6 h-6 text-emerald-400 shrink-0 mt-0.5"></i>
                            <span class="font-medium"><strong class="text-white font-black">Refaz o que falhou.</strong> Se o portal cair ou a busca for interrompida, o robô agenda nova tentativa e refaz o período exato pedido, com a fila visível no painel Retentativas.</span>
                        </li>
                    </ul>
                </div>

                <!-- Coluna Direita: Formulário de Ativação -->
                <div class="lg:col-span-5 w-full max-w-md mx-auto lg:mx-0" data-aos="fade-left" data-aos-delay="200">
                    <div class="card-premium card-static p-8 sm:p-10 rounded-[2.5rem] shadow-2xl relative overflow-hidden bg-white">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none"></div>

                        <h2 class="text-2xl font-black text-slate-800 mb-2 leading-tight">Baixe o robô no seu escritório</h2>
                        <p class="text-slate-500 text-sm mb-8 font-medium">
                            Libere o acesso ao instalador do robô.
                            <span class="text-red-500 font-bold block mt-1 text-[10px] uppercase tracking-wider">(Todos os campos obrigatórios)</span>
                        </p>

                        <form id="hero-form" class="space-y-4 relative z-10" novalidate>
                            <input type="text" id="nome_completo" name="nome_completo" autocomplete="name" placeholder="Nome Completo" required
                                class="w-full px-5 py-3.5 sm:py-4 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition font-medium text-slate-700 placeholder:text-slate-400">
                            <input type="email" id="email_profissional" name="email_profissional" autocomplete="email" placeholder="E-mail Profissional" required
                                class="w-full px-5 py-3.5 sm:py-4 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition font-medium text-slate-700 placeholder:text-slate-400">
                            <div class="grid grid-cols-2 gap-3 sm:gap-4">
                                <input type="tel" id="whatsapp" name="whatsapp" autocomplete="tel" placeholder="WhatsApp" required minlength="15"
                                    class="w-full px-4 sm:px-5 py-3.5 sm:py-4 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition font-medium text-slate-700 placeholder:text-slate-400 text-sm sm:text-base">
                                <input type="text" id="cnpj" name="cnpj" placeholder="CNPJ do Escritório" required minlength="18"
                                    class="w-full px-4 sm:px-5 py-3.5 sm:py-4 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition font-medium text-slate-700 placeholder:text-slate-400 text-sm sm:text-base">
                            </div>

                            <button type="submit" id="btn-submit" aria-label="Baixar o robô Nota Fácil para Windows"
                                class="w-full mt-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-black py-5 rounded-xl shadow-lg shadow-blue-500/30 transition-all transform hover:-translate-y-1 active:scale-95 text-lg uppercase tracking-wider relative overflow-hidden group">
                                <span id="btn-text" class="relative z-10 flex items-center justify-center gap-2">
                                    <i data-lucide="shield-check" class="w-5 h-5"></i>
                                    BAIXAR O ROBÔ
                                </span>
                            </button>
                        </form>

                        <div class="mt-6 pt-6 border-t border-slate-100 relative z-10">
                            <p class="text-[11px] sm:text-xs text-slate-600 font-bold flex gap-3 leading-relaxed">
                                <i data-lucide="gift" class="w-5 h-5 text-emerald-500 shrink-0"></i>
                                <span>Não é um teste de 7 dias. O plano de 100 notas/mês é grátis para sempre, com CNPJs ilimitados e sem cartão de crédito. Instalação oficial e segura pela Microsoft Store, com atualizações automáticas. Upgrade dentro do app, sem fidelidade.</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bloco 1B: VÍDEO — anúncio de 25s. O iframe só é criado após o clique (poster local, sem requisição ao YouTube antes) -->
    <section class="py-20 bg-slate-50 border-b border-slate-100 relative z-20">
        <div class="container mx-auto px-6">
            <div class="text-center mb-10" data-aos="fade-up">
                <span class="text-blue-600 font-black uppercase tracking-widest text-xs">Em 25 segundos</span>
                <h2 class="text-3xl lg:text-4xl font-black text-slate-900 leading-tight mt-4 max-w-3xl mx-auto">
                    Sua rotina fiscal <span class="text-blue-600">no piloto automático</span>
                </h2>
            </div>

            <div id="video-anuncio" class="relative aspect-video max-w-3xl mx-auto rounded-[2rem] overflow-hidden shadow-2xl bg-slate-900" data-aos="fade-up">
                <button type="button" data-video-id="uSVEjHhruYo" aria-label="Assistir ao anúncio do Nota Fácil (25 segundos)" class="group absolute inset-0 w-full h-full cursor-pointer focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-400">
                    <Image src={posterAnuncio} alt="Apresentadora do Nota Fácil Downloader em um escritório, com o texto Notas no automático" width={960} height={540} loading="lazy" class="w-full h-full object-cover" />
                    <span class="absolute inset-0 bg-slate-900/20 group-hover:bg-slate-900/10 transition-colors"></span>
                    <span class="absolute inset-0 flex items-center justify-center">
                        <span class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-blue-600 group-hover:bg-blue-500 text-white flex items-center justify-center shadow-2xl transition-transform group-hover:scale-110">
                            <i data-lucide="play" class="w-9 h-9 ml-1"></i>
                        </span>
                    </span>
                </button>
            </div>

            <p class="text-center text-sm text-slate-500 font-medium mt-6 max-w-2xl mx-auto leading-relaxed">
                Com certificado A1 ou A3, a coleta usa a API oficial e nem passa por captcha. No login e senha, o robô resolve os desafios por você.
            </p>
            <div class="text-center mt-8">
                <a href="#ativar" class="inline-flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-500 text-white px-10 py-5 rounded-2xl font-black transition-all shadow-xl shadow-blue-500/20 active:scale-95 text-lg uppercase tracking-wider">
                    <i data-lucide="download" class="w-5 h-5"></i>
                    Baixar o robô
                </a>
            </div>
        </div>
    </section>

    <script is:inline>
        // Facade do vídeo: só cria o iframe (youtube-nocookie) após o clique e registra o evento video_play.
        document.addEventListener('DOMContentLoaded', function () {
            var box = document.getElementById('video-anuncio');
            var btn = box && box.querySelector('button[data-video-id]');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-video-id');
                var frame = document.createElement('iframe');
                frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1&hl=pt-BR&cc_load_policy=1';
                frame.title = 'Anúncio Nota Fácil: automatize o download de NFS-e';
                frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
                frame.allowFullscreen = true;
                frame.referrerPolicy = 'strict-origin-when-cross-origin';
                frame.className = 'absolute inset-0 w-full h-full';
                box.replaceChildren(frame);
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({ 'event': 'video_play', 'video_id': id, 'video_title': 'Anuncio Ana Luisa 25s', 'video_location': 'home_apos_hero' });
            });
        });
    </script>

    <!-- Bloco 2: PROVA OPERACIONAL (números reais da base) -->
    <section class="py-20 bg-white border-b border-slate-100 relative z-20">
        <div class="container mx-auto px-6">
            <div class="text-center mb-16" data-aos="fade-up">
                <span class="text-blue-600 font-black uppercase tracking-widest text-xs">Números da operação</span>
                <h2 class="text-3xl lg:text-4xl font-black text-slate-900 leading-tight mt-4 max-w-3xl mx-auto">
                    Trabalho manual que o robô já <span class="text-blue-600">tirou das equipes</span>
                </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
                <div class="bg-slate-50 p-8 rounded-[2rem] border border-slate-200 text-center" data-aos="fade-up" data-aos-delay="100">
                    <span class="block text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">{fmt(notasProcessadas)}</span>
                    <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider mt-2">Notas capturadas</span>
                </div>
                <div class="bg-slate-50 p-8 rounded-[2rem] border border-slate-200 text-center" data-aos="fade-up" data-aos-delay="200">
                    <span class="block text-3xl sm:text-4xl font-black text-emerald-600 tracking-tight">{fmt(horasDevolvidas)}h</span>
                    <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider mt-2">Horas de trabalho manual*</span>
                </div>
                <div class="bg-slate-50 p-8 rounded-[2rem] border border-slate-200 text-center" data-aos="fade-up" data-aos-delay="250">
                    <span class="block text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">{fmt(jornadasDevolvidas)}</span>
                    <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider mt-2">Jornadas de 8h*</span>
                </div>
            </div>

            <p class="text-center text-xs text-slate-400 font-medium mt-8 max-w-2xl mx-auto leading-relaxed">
                Notas capturadas: base real do Nota Fácil. *Horas e jornadas são estimativas, calculadas com <strong class="text-slate-500">2 minutos de trabalho manual por nota</strong> (captchas do Portal Nacional, download, organização e renomeação dos arquivos nas pastas).
            </p>
        </div>
    </section>

    <!-- Bloco 3: O ELEFANTE NA SALA — Por que sistemas web travam e o desktop não -->
    <section class="py-24 bg-slate-900 relative overflow-hidden border-y border-slate-800">
        <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-blue-600/20 rounded-full blur-[120px]"></div>
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-indigo-600/10 rounded-full blur-[120px]"></div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-5xl mx-auto text-center mb-16" data-aos="fade-up">
                <h2 class="text-3xl lg:text-5xl font-black text-white leading-tight mb-6">
                    A verificação do governo parou o seu sistema em nuvem?
                </h2>
                <p class="text-lg text-slate-400 font-medium leading-relaxed max-w-3xl mx-auto">
                    Plataformas web precisam resolver o desafio de um servidor remoto, longe da sessão do usuário — e é aí que elas travam. O Nota Fácil é um software nativo: ele processa a verificação na sua própria máquina, dentro da mesma sessão que já está autenticada no portal.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                <div class="bg-white/5 backdrop-blur-lg border border-white/10 p-10 rounded-[2.5rem]" data-aos="fade-up" data-aos-delay="100">
                    <div class="w-16 h-16 bg-blue-500/20 text-blue-400 rounded-2xl flex items-center justify-center mb-8">
                        <i data-lucide="scan-eye" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-white mb-4">Motor anti-captcha dedicado</h3>
                    <p class="text-slate-300 leading-relaxed font-medium">Reconhecimento visual próprio decifra as barreiras do governo em silêncio. Você não precisa clicar em nada enquanto o lote de empresas roda em segundo plano.</p>
                </div>

                <div class="bg-white/5 backdrop-blur-lg border border-white/10 p-10 rounded-[2.5rem]" data-aos="fade-up" data-aos-delay="200">
                    <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-2xl flex items-center justify-center mb-8">
                        <i data-lucide="refresh-cw" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-white mb-4">Resiliência à instabilidade</h3>
                    <p class="text-slate-300 leading-relaxed font-medium">Quando o Portal Nacional oscila no pico do fechamento, o robô percebe a indisponibilidade em 1 segundo, agenda nova tentativa e refaz o período exato pedido, com a fila no painel Retentativas. Certificado vencido não derruba a rotina: ele registra o alerta e segue com o resto da carteira.</p>
                </div>

                <div class="bg-white/5 backdrop-blur-lg border border-white/10 p-10 rounded-[2.5rem]" data-aos="fade-up" data-aos-delay="300">
                    <div class="w-16 h-16 bg-purple-500/20 text-purple-400 rounded-2xl flex items-center justify-center mb-8">
                        <i data-lucide="server-off" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-white mb-4">Nada sai da sua máquina</h3>
                    <p class="text-slate-300 leading-relaxed font-medium">O certificado (A1 ou A3) e as credenciais gov.br nunca vão para a nuvem. A conexão é do seu computador direto para o portal do governo, em conformidade com a LGPD e o sigilo fiscal.</p>
                </div>
            </div>

            <div class="text-center mt-16" data-aos="fade-up">
                <a href="#ativar" class="inline-flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-500 text-white px-10 py-5 rounded-2xl font-black transition-all shadow-xl shadow-blue-500/20 active:scale-95 text-lg uppercase tracking-wider">
                    <i data-lucide="shield-check" class="w-5 h-5"></i>
                    Baixar o robô
                </a>
            </div>
        </div>
    </section>

    <!-- Bloco 4: Autenticação — Certificado Digital A1 ou Login e Senha -->
    <section class="py-24 bg-white relative z-20">
        <div class="container mx-auto px-6">
            <div class="text-center mb-16" data-aos="fade-up">
                <span class="text-blue-600 font-black uppercase tracking-widest text-xs">Como o robô entra no portal</span>
                <h2 class="text-4xl lg:text-5xl font-black text-slate-900 leading-tight mt-4 max-w-4xl mx-auto">
                    Coleta por <span class="text-blue-600">Certificado Digital</span> ou por login e senha
                </h2>
                <p class="text-lg text-slate-600 font-medium max-w-2xl mx-auto mt-6 leading-relaxed">
                    Cada cliente da sua carteira tem uma realidade. O Nota Fácil atende as duas formas de acesso ao Portal Nacional — na mesma rotina, no mesmo lote.
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto items-stretch">
                <!-- Certificado Digital A1 (destaque) -->
                <div class="bg-slate-900 p-10 sm:p-12 rounded-[2.5rem] border border-slate-800 shadow-xl relative overflow-hidden flex flex-col" data-aos="fade-right">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/20 rounded-full blur-[80px] -mr-32 -mt-32"></div>
                    <div class="relative z-10 flex flex-col h-full">
                        <div class="w-16 h-16 bg-blue-500/20 text-blue-400 rounded-2xl flex items-center justify-center mb-8 border border-blue-500/30">
                            <i data-lucide="file-badge" class="w-8 h-8"></i>
                        </div>
                        <span class="inline-flex self-start items-center gap-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-black px-3 py-1 rounded-full text-[10px] uppercase tracking-widest mb-6">
                            A1 e A3
                        </span>
                        <h3 class="text-3xl font-black text-white mb-6">Certificado Digital A1 e A3</h3>
                        <p class="text-slate-300 leading-relaxed font-medium mb-8">
                            O robô lê os certificados já instalados no repositório do Windows: A1 em arquivo e A3 em token USB ou cartão. Você seleciona qual empresa quer cadastrar pelo certificado, sem subir nada para lugar nenhum. Com token A3, instale antes o gerenciador do fabricante.
                        </p>
                        <ul class="space-y-4 mt-auto">
                            <li class="flex gap-3 text-slate-200 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5"></i>
                                <span><strong class="text-white">Coleta pela API oficial: sem captcha no caminho</strong></span>
                            </li>
                            <li class="flex gap-3 text-slate-200 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5"></i>
                                <span>Seleção da empresa direto no repositório do Windows, com A1 ou A3</span>
                            </li>
                            <li class="flex gap-3 text-slate-200 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5"></i>
                                <span>Carteira inteira em lote, sem limite de CNPJs</span>
                            </li>
                            <li class="flex gap-3 text-slate-200 font-medium">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5"></i>
                                <span>Certificado vencido não derruba a rotina: o robô sinaliza e segue com o resto</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Login e Senha -->
                <div class="bg-slate-50 p-10 sm:p-12 rounded-[2.5rem] border border-slate-200 shadow-sm flex flex-col" data-aos="fade-left">
                    <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mb-8">
                        <i data-lucide="key-round" class="w-8 h-8"></i>
                    </div>
                    <span class="inline-flex self-start items-center gap-2 bg-blue-100 text-blue-700 border border-blue-200 font-black px-3 py-1 rounded-full text-[10px] uppercase tracking-widest mb-6">
                        Para MEIs e empresas menores
                    </span>
                    <h3 class="text-3xl font-black text-slate-900 mb-6">Login e Senha</h3>
                    <p class="text-slate-600 leading-relaxed font-medium mb-8">
                        Nem todo cliente da carteira tem certificado digital. Nesses casos o robô navega no portal com as credenciais de acesso — e é aqui que ele resolve os captchas por você, executando a mesma rotina de captura em lote.
                    </p>
                    <ul class="space-y-4 mt-auto">
                        <li class="flex gap-3 text-slate-700 font-medium">
                            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5"></i>
                            <span><strong class="text-slate-900">Captchas do portal resolvidos pelo robô</strong></span>
                        </li>
                        <li class="flex gap-3 text-slate-700 font-medium">

    <!-- Scripts e lógicas da Landing Page -->
    <script is:inline>
        function isValidCNPJ(cnpj) {
            cnpj = cnpj.replace(/[^\d]+/g, '');
            if (cnpj == '' || cnpj.length != 14) return false;
            if (/^(\d)\1+$/.test(cnpj)) return false; // Elimina sequências repetidas (00..., 11..., etc)

            let tamanho = cnpj.length - 2
            let numeros = cnpj.substring(0, tamanho);
            let digitos = cnpj.substring(tamanho);
            let soma = 0;
            let pos = tamanho - 7;
            for (let i = tamanho; i >= 1; i--) {
                soma += numeros.charAt(tamanho - i) * pos--;
                if (pos < 2) pos = 9;
            }
            let resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
            if (resultado != digitos.charAt(0)) return false;

            tamanho = tamanho + 1;
            numeros = cnpj.substring(0, tamanho);
            soma = 0;
            pos = tamanho - 7;
            for (let i = tamanho; i >= 1; i--) {
                soma += numeros.charAt(tamanho - i) * pos--;
                if (pos < 2) pos = 9;
            }
            resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
            if (resultado != digitos.charAt(1)) return false;

            return true;
        }

        function isValidPhone(phone) {
            phone = phone.replace(/[^\d]+/g, '');
            if (phone.length < 10 || phone.length > 11) return false;
            if (/^(\d)\1+$/.test(phone)) return false; // Elimina sequências repetidas
            
            // Verifica se o DDD é válido (não pode começar com 0)
            if (phone.charAt(0) === '0') return false;
            
            // Dummy logic for "00 00000 0000" or similar cases mentioned by user
            if (phone.substring(0, 2) === '00') return false;

            return true;
        }

        document.addEventListener('DOMContentLoaded', function () {
            IMask(document.getElementById('whatsapp'), { mask: '(00) 00000-0000' });
            IMask(document.getElementById('cnpj'), { mask: '00.000.000/0000-00' });
        });

        function toggleFaq(button) {
            const item = button.parentElement;
            const isActive = item.classList.contains('active');

            // Fechar todos os outros
            document.querySelectorAll('.faq-item').forEach(otherItem => {
                otherItem.classList.remove('active');
            });

            // Abrir o atual se não estava aberto
            if (!isActive) {
                item.classList.add('active');
            }
        }

        // Formulário de Registro e Download
        document.getElementById('hero-form').addEventListener('submit', async function (e) {
            e.preventDefault();

            const form = e.target;
            const btn = document.getElementById('btn-submit');
            const btnText = document.getElementById('btn-text');
            const originalText = btnText.innerHTML;

            const nome = document.getElementById('nome_completo').value.trim();
            const email = document.getElementById('email_profissional').value.trim();
            const whatsapp = document.getElementById('whatsapp').value;
            const cnpj = document.getElementById('cnpj').value;

            // Verificação básica de preenchimento
            if (!nome || !email || !whatsapp || !cnpj) {
                Swal.fire({
                    title: 'Dados Incompletos',
                    text: 'Por favor, preencha todos os campos do formulário.',
                    icon: 'warning',
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#3b82f6'
                });
                return;
            }

            // Validação de Telefone
            if (!isValidPhone(whatsapp)) {
                Swal.fire({
                    title: 'Telefone Inválido',
                    text: 'Por favor, insira um número de WhatsApp real.',
                    icon: 'warning',
                    confirmButtonText: 'Corrigir',
                    confirmButtonColor: '#3b82f6'
                });
                return;
            }

            // Validação de CNPJ
            if (!isValidCNPJ(cnpj)) {
                Swal.fire({
                    title: 'CNPJ Inválido',
                    text: 'O CNPJ informado não é válido. Verifique os dados.',
                    icon: 'warning',
                    confirmButtonText: 'Corrigir',
                    confirmButtonColor: '#3b82f6'
                });
                return;
            }

            // Recuperar GCLID da URL ou do sessionStorage
            const gclid = sessionStorage.getItem('gclid') || (new URLSearchParams(window.location.search)).get('gclid');

            const payload = {
                action: 'register',
                nome: nome,
                email: email,
                whatsapp: whatsapp,
                cnpj: cnpj,
                gclid: gclid
            };

            try {
                // Estado de Loading
                btn.disabled = true;
                btn.classList.add('opacity-70', 'cursor-not-allowed');
                btn.classList.remove('hover:-translate-y-1', 'active:scale-95');
                btnText.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> PREPARANDO ACESSO...';
                lucide.createIcons();

                const response = await fetch('https://n8n.rockethub.com.br/webhook/17e601cd-2655-410f-b8af-4ffffd07bec0', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.status === 201 || response.ok) {
                    const responseDataText = await response.text();
                    let responseData;
                    try {
                        responseData = JSON.parse(responseDataText);
                    } catch(e) {
                        responseData = {};
                    }

                    // O webhook pode retornar um array de objetos
                    let responseObj = responseData;
                    if (Array.isArray(responseData) && responseData.length > 0) {
                        responseObj = responseData[0];
                    }

                    // Verificar se o backend retornou um status de erro lógico (ex: CNPJ duplicado)
                    if (responseObj && responseObj.status === 'error') {
                        Swal.fire({
                            title: 'Cadastro já realizado',
                            text: responseObj.message || 'Este CNPJ ou e-mail já possuem uma licença ativa.',
                            icon: 'info',
                            confirmButtonText: 'Baixar Sistema Novamente',
                            showCancelButton: true,
                            cancelButtonText: 'Corrigir Dados',
                            confirmButtonColor: '#3b82f6',
                            cancelButtonColor: '#94a3b8'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/obrigado/';
                            }
                        });
                        return;
                    }

                    // Salvar os dados (nome, cnpj, razao, plano, url_download, etc) para usar na página de Boas-Vindas
                    sessionStorage.setItem('notafacil_user_data', JSON.stringify(responseObj));

                    form.reset();
                    window.location.href = '/obrigado/';

                } else {
                    throw new Error('Erro na requisição');
                }

            } catch (error) {
                console.error('Erro:', error);
                Swal.fire({
                    title: 'Ops!',
                    text: 'Ocorreu um erro ao processar seu cadastro. Tente novamente.',
                    icon: 'error',
                    confirmButtonText: 'Fechar',
                    confirmButtonColor: '#ef4444' // text-red-500
                });
            } finally {
                // Restaurar Botão
                btn.disabled = false;
                btn.classList.remove('opacity-70', 'cursor-not-allowed');
                btn.classList.add('hover:-translate-y-1', 'active:scale-95');
                btnText.innerHTML = originalText;
            }
        });
    </script>


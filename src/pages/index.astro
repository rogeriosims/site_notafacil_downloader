---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Nota Fácil | Automação de NFS-e Nacional" description="O software desktop que captura XML e PDF em lote, organiza nas suas pastas e gera planilhas de conferência." bodyClass="bg-slate-50 text-slate-900 overflow-x-hidden">




    <!-- DOBRA 1: HERO SECTION -->
    <section id="hero" class="hero-gradient pt-24 pb-32 lg:pt-48 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-20 pointer-events-none overflow-hidden">
            <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-blue-600 rounded-full blur-[150px] will-change-transform"></div>
            <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] bg-purple-600 rounded-full blur-[150px] will-change-transform">
            </div>
        </div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start lg:items-center">
                <!-- Coluna Esquerda: Texto + Imagem -->
                <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left h-full"
                    data-aos="fade-right">
                    <span
                        class="inline-block bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] sm:text-xs font-black px-4 py-2 rounded-full mb-6 sm:mb-8 uppercase tracking-[0.2em] shadow-[0_0_15px_rgba(16,185,129,0.3)]">
                        <i data-lucide="zap" class="w-4 h-4 inline-block -mt-1 mr-1"></i> Software para Escritórios Contábeis
                    </span>
                    <h1
                        class="text-3xl sm:text-4xl lg:text-6xl font-black text-white leading-tight mb-6 sm:mb-8 tracking-tight">
                        Captura de NFS-e do Portal Nacional em Lote. 
                        <span class="text-gradient">
                            Deixe o Robô Clicar por Você.
                        </span>
                    </h1>
                    <p class="text-lg lg:text-xl text-slate-400 leading-relaxed mb-8 sm:mb-12 max-w-2xl" itemprop="description">
                        O robô que faz a captura em lote de XML e PDF de toda a sua carteira. Autentique via Certificado A1 ou Login e Senha, e deixe o sistema organizar as pastas do seu ERP e gerar planilhas de conferência automaticamente.
                    </p>


                </div>

                <!-- Coluna Direita: Formulário -->
                <div class="lg:col-span-5 w-full max-w-md mx-auto" data-aos="fade-left" data-aos-delay="200">
                    <div class="card-premium p-8 sm:p-10 rounded-[2.5rem] shadow-2xl relative overflow-hidden bg-white">
                        <div
                            class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none">
                        </div>

                        <h2 class="text-2xl font-black text-slate-800 mb-2 leading-tight">Ative sua Licença Gratuita
                        </h2>
                        <p class="text-slate-500 text-sm mb-8 font-medium">Libere o acesso instantâneo ao instalador. <span class="text-red-500 font-bold block mt-1 text-[10px] uppercase tracking-wider">(Todos os campos obrigatórios)</span>
                        </p>

                        <form id="hero-form" class="space-y-4 relative z-10">
                            <input type="text" id="nome_completo" placeholder="Nome Completo" required
                                class="w-full px-5 py-3.5 sm:py-4 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition font-medium text-slate-700 placeholder:text-slate-400">
                            <input type="email" id="email_profissional" placeholder="E-mail Profissional" required
                                class="w-full px-5 py-3.5 sm:py-4 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition font-medium text-slate-700 placeholder:text-slate-400">
                            <div class="grid grid-cols-2 gap-3 sm:gap-4">
                                <input type="tel" id="whatsapp" placeholder="WhatsApp" required minlength="15"
                                    class="w-full px-4 sm:px-5 py-3.5 sm:py-4 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition font-medium text-slate-700 placeholder:text-slate-400 text-sm sm:text-base">
                                <input type="text" id="cnpj" placeholder="CNPJ do Escritório" required minlength="18"
                                    class="w-full px-4 sm:px-5 py-3.5 sm:py-4 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition font-medium text-slate-700 placeholder:text-slate-400 text-sm sm:text-base">
                            </div>

                            <button type="submit" id="btn-submit" aria-label="Ativar licença gratuita do robô Nota Fácil para Windows"
                                class="w-full mt-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-black py-5 rounded-xl shadow-lg shadow-blue-500/30 transition-all transform hover:-translate-y-1 active:scale-95 text-lg uppercase tracking-wider relative overflow-hidden group">
                                <span id="btn-text" class="relative z-10 flex items-center justify-center gap-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                    </svg>
                                    ATIVAR MINHA LICENÇA GRÁTIS
                                </span>
                            </button>
                        </form>

                        <div class="mt-6 pt-6 border-t border-slate-100 relative z-10">
                            <p class="text-[11px] sm:text-xs text-slate-600 font-bold flex gap-3 leading-relaxed">
                                <i data-lucide="gift" class="w-5 h-5 text-emerald-500 shrink-0"></i>
                                <span>Não é um teste de 7 dias. O plano de 100 notas/mês é grátis para sempre. Sem
                                    cartão de crédito.</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Título do Vídeo -->
            <p class="text-sm font-black text-slate-400 mb-2 text-center uppercase tracking-widest mt-12" data-aos="fade-up" data-aos-delay="250">
                ▶ Veja o robô em ação (1 minuto)
            </p>

            <!-- Imagem Destacada / Vídeo de Demonstração (LITE LOAD) -->
            <div class="w-full max-w-5xl mx-auto relative rounded-xl sm:rounded-3xl overflow-hidden shadow-[0_30px_100px_rgba(37,99,235,0.2)] border border-white/10 bg-slate-900 group"
                style="aspect-ratio: 16/9;" data-aos="fade-up" data-aos-delay="300" id="video-container">
                
                <!-- Thumbnail de Pré-carregamento -->
                <div id="video-placeholder" class="absolute inset-0 cursor-pointer flex items-center justify-center transition-transform duration-700 hover:scale-105">
                    <img 
                        src="/assets/video-thumb.jpg" 
                        alt="Thumbnail Vídeo Nota Fácil" 
                        class="absolute inset-0 w-full h-full object-cover opacity-60 transition-opacity duration-500 group-hover:opacity-80"
                        loading="eager"
                        fetchpriority="high"
                    />
                    <!-- Overlay de Play -->
                    <div class="relative z-20 w-20 h-20 sm:w-28 sm:h-28 bg-blue-600/90 rounded-full flex items-center justify-center shadow-2xl transition-all duration-300 group-hover:bg-blue-500 group-hover:scale-110">
                        <svg class="w-8 h-8 sm:w-12 sm:h-12 text-white ml-2" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z"/>
                        </svg>
                    </div>
                </div>

                <script is:inline>
                    document.getElementById('video-placeholder').addEventListener('click', function() {
                        const container = document.getElementById('video-container');
                        container.innerHTML = `
                            <iframe 
                                width="100%" 
                                height="100%" 
                                src="https://www.youtube-nocookie.com/embed/Gh8B4aInzCs?autoplay=1&controls=1&rel=0&modestbranding=1&showinfo=0&vq=hd720&hl=pt-br" 
                                title="Nota Fácil Demonstração" 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen
                                class="w-full h-full object-cover relative z-10">
                            </iframe>
                        `;
                    });
                </script>
                
                <div class="absolute inset-0 pointer-events-none ring-1 ring-inset ring-white/10 rounded-xl sm:rounded-3xl"></div>
            </div>
            <!-- Mini-objeções técnicas (Segurança & LGPD) -->
            <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-5xl mx-auto" data-aos="fade-up">
                <div class="bg-white/10 backdrop-blur-sm border border-white/20 p-5 rounded-2xl flex items-center gap-4 group hover:bg-white/20 transition-all">
                    <div class="w-10 h-10 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center shrink-0">
                        <i data-lucide="shield-check" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <p class="text-white font-bold text-xs">Dados 100% Locais</p>
                        <p class="text-slate-400 text-[10px]">Certificados e XMLs nunca saem do seu computador.</p>
                    </div>
                </div>
                <div class="bg-white/10 backdrop-blur-sm border border-white/20 p-5 rounded-2xl flex items-center gap-4 group hover:bg-white/20 transition-all">
                    <div class="w-10 h-10 bg-blue-500/20 text-blue-400 rounded-full flex items-center justify-center shrink-0">
                        <i data-lucide="lock" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <p class="text-white font-bold text-xs">Conformidade LGPD</p>
                        <p class="text-slate-400 text-[10px]">Segurança total conforme nossa <a href="/politica-de-privacidade" class="underline decoration-blue-500/30 hover:text-blue-300">Política de Privacidade</a>.</p>
                    </div>
                </div>
                <div class="bg-white/10 backdrop-blur-sm border border-white/20 p-5 rounded-2xl flex items-center gap-4 group hover:bg-white/20 transition-all">
                    <div class="w-10 h-10 bg-purple-500/20 text-purple-400 rounded-full flex items-center justify-center shrink-0">
                        <i data-lucide="activity" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <p class="text-white font-bold text-xs">Telemetria Ética</p>
                        <p class="text-slate-400 text-[10px]">Apenas performance e créditos. Zero acesso ao sigilo fiscal.</p>
                    </div>
                </div>
            </div>            
        </div>
    </section>

    <!-- SEÇÃO NOVIDADES V3.3.0 -->
    <section id="novidades" class="py-24 bg-white relative z-20">
        <div class="container mx-auto px-6">
            <div class="max-w-6xl mx-auto">
                <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
                    
                    <!-- Card Independência Fiscal -->
                    <a href="/independencia-fiscal-2026" class="group block relative overflow-hidden bg-slate-900 rounded-[2.5rem] p-8 sm:p-10 shadow-2xl transition-all hover:-translate-y-2 hover:shadow-orange-500/10">
                        <div class="absolute top-0 right-0 w-64 h-64 bg-orange-500/10 rounded-full blur-[80px] -mr-32 -mt-32 transition-transform group-hover:scale-150"></div>
                        <div class="relative z-10">
                            <div class="flex items-center gap-3 mb-6">
                                <span class="px-3 py-1 bg-orange-500 text-white text-[10px] font-black rounded-full uppercase tracking-widest">Destaque v3.3.0</span>
                                <span class="text-orange-400 font-black text-xs uppercase tracking-widest flex items-center gap-1">
                                    <i data-lucide="shield-check" class="w-4 h-4"></i> Blindagem 2026
                                </span>
                            </div>
                            <h3 class="text-2xl sm:text-3xl font-black text-white mb-4 leading-tight">Independência Fiscal: Geração de PDF Local</h3>
                            <p class="text-slate-400 font-medium mb-8">O governo vai desligar a API de PDFs em Julho. Saiba como o Nota Fácil garante seus documentos mesmo offline.</p>
                            <span class="inline-flex items-center gap-2 text-orange-400 font-black text-sm group-hover:gap-4 transition-all">
                                VER TECNOLOGIA <i data-lucide="arrow-right" class="w-5 h-5"></i>
                            </span>
                        </div>
                    </a>

                    <!-- Card Microsoft Store -->
                    <a href="/microsoft-store" class="group block relative overflow-hidden bg-white border border-slate-200 rounded-[2.5rem] p-8 sm:p-10 shadow-xl transition-all hover:-translate-y-2 hover:shadow-blue-500/10 hover:border-blue-200">
                        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/5 rounded-full blur-[80px] -mr-32 -mt-32 transition-transform group-hover:scale-150"></div>
                        <div class="relative z-10">
                            <div class="flex items-center gap-3 mb-6">
                                <span class="px-3 py-1 bg-blue-600 text-white text-[10px] font-black rounded-full uppercase tracking-widest">Oficial Windows</span>
                                <span class="text-blue-600 font-black text-xs uppercase tracking-widest flex items-center gap-1">
                                    <i data-lucide="verified" class="w-4 h-4"></i> App Verificado
                                </span>
                            </div>
                            <h3 class="text-2xl sm:text-3xl font-black text-slate-900 mb-4 leading-tight">Agora na Microsoft Store</h3>
                            <p class="text-slate-500 font-medium mb-8">Instalação 100% segura, silenciosa e com atualizações automáticas direto pelo Windows.</p>
                            <span class="inline-flex items-center gap-2 text-blue-600 font-black text-sm group-hover:gap-4 transition-all">
                                ACESSAR A LOJA <i data-lucide="arrow-right" class="w-5 h-5"></i>
                            </span>
                        </div>
                    </a>

                </div>
            </div>
        </div>
    </section>

    <!-- DOBRA 2: A DOR -->
    <section id="dor" class="py-16 lg:py-24 bg-zinc-50 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/5 rounded-full blur-[100px] pointer-events-none translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-orange-500/5 rounded-full blur-[100px] pointer-events-none -translate-x-1/2 translate-y-1/2"></div>
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto text-center mb-20" data-aos="fade-up">
                <h2 class="text-4xl lg:text-5xl font-black text-slate-900 leading-tight">
                    O Portal Nacional centralizou as notas, mas <span class="text-red-500">reduziu drasticamente a sua produtividade.</span>
                </h2>
            </div>

            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                <div class="group p-10 rounded-[2.5rem] bg-white border border-slate-200 shadow-[0_20px_50px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(239,68,68,0.1)] hover:border-red-100 transition-all duration-500"
                    data-aos="fade-up" data-aos-delay="100">
                    <div
                        class="w-16 h-16 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-500 shadow-sm">
                        <i data-lucide="alert-triangle" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">O Caos do "Um a Um"</h3>
                    <p class="text-slate-500 leading-relaxed font-medium">Localizar a nota, clicar para obter o XML,
                        voltar, clicar para obter o PDF. Repetir isso para centenas de notas. Um trabalho lento,
                        exaustivo e que trava o processo do seu escritório.</p>
                </div>

                <div class="group p-10 rounded-[2.5rem] bg-white border border-slate-200 shadow-[0_20px_50px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(249,115,22,0.1)] hover:border-orange-100 transition-all duration-500"
                    data-aos="fade-up" data-aos-delay="200">
                    <div
                        class="w-16 h-16 bg-orange-50 text-orange-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-500 shadow-sm">
                        <i data-lucide="key" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">O Pesadelo dos Acessos</h3>
                    <p class="text-slate-500 leading-relaxed font-medium">Ter que logar e deslogar empresa por empresa,
                        alternando certificados ou digitando senhas do gov.br repetidamente.</p>
                </div>

                <div class="group p-10 rounded-[2.5rem] bg-white border border-slate-200 shadow-[0_20px_50px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(239,68,68,0.1)] hover:border-red-100 transition-all duration-500"
                    data-aos="fade-up" data-aos-delay="300">
                    <div
                        class="w-16 h-16 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-500 shadow-sm">
                        <i data-lucide="folder-minus" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">A Desorganização Total</h3>
                    <p class="text-slate-500 leading-relaxed font-medium">Perder horas extraindo pastas ZIP misturadas,
                        renomeando arquivos e tentando organizar tudo para o seu sistema ERP conseguir importar.</p>
                </div>
            </div>
            <!-- Prova Social da Agecon -->
            <div class="mt-20 max-w-4xl mx-auto" data-aos="fade-up">
                <div class="bg-white p-8 sm:p-12 rounded-[3rem] border border-slate-200 shadow-xl relative overflow-hidden flex flex-col md:flex-row items-center gap-10">
                    <div class="shrink-0">
                        <a href="https://ageconbh.com.br/" target="_blank" rel="noopener noreferrer" class="group/logo block transition-all duration-300">
                            <img src="assets/logo_agecon.png" alt="Logo Agecon" class="h-20 sm:h-24 w-auto mix-blend-multiply contrast-125 saturate-150 transform transition-transform group-hover/logo:scale-110">
                        </a>
                    </div>
                    <div class="flex-1 text-center md:text-left">
                        <p class="text-xl text-slate-700 font-medium italic mb-6 leading-relaxed">
                            "Reduzimos drasticamente o tempo de captura de notas. O sistema é robusto e resolveu o nosso gargalo operacional no Portal Nacional."
                        </p>
                        <div class="flex flex-col md:flex-row md:items-center gap-4">
                            <div>
                                <p class="text-slate-900 font-black">Claudio</p>
                                <p class="text-slate-500 text-sm font-bold uppercase tracking-wider">
                                    Diretor | <a href="https://ageconbh.com.br/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 transition-colors underline decoration-blue-500/20 underline-offset-4">Agecon Contabilidade</a>
                                </p>
                            </div>
                            <div class="hidden md:block w-px h-8 bg-slate-200"></div>
                            <div class="flex items-center justify-center md:justify-start gap-2 text-emerald-600 font-black italic">
                                <i data-lucide="trending-up" class="w-5 h-5"></i>
                                <span>+ 3.000 notas automatizadas/mês</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>            
        </div>
    </section>

    <!-- DOBRA 3: A SOLUÇÃO -->
    <section id="solucao" class="py-16 lg:py-24 bg-white relative">
        <div class="container mx-auto px-6 relative z-10">
            <div class="text-center mb-20" data-aos="fade-up">
                <span class="text-emerald-500 font-black uppercase tracking-[0.3em] text-xs">Paz de Espírito</span>
                <h2 class="text-4xl lg:text-5xl font-black text-slate-900 mt-4 leading-tight">
                    Instale, Conecte e <span class="text-emerald-500">Recupere Dias de Trabalho.</span>
                </h2>
            </div>

            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                <div class="group p-10 rounded-[2.5rem] bg-white border border-slate-100 hover:border-emerald-200 transition-all duration-500 shadow-[0_20px_50px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(16,185,129,0.08)]"
                    data-aos="fade-up" data-aos-delay="100">
                    <div
                        class="w-16 h-16 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-all duration-500">
                        <i data-lucide="zap" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4 items-center flex gap-3"><span
                            class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500 text-white text-[10px]">✓</span>
                        Rapidez</h3>
                    <p class="text-slate-500 leading-relaxed font-medium">Captura em Lote (XML + PDF). Com um clique, o
                        robô faz a varredura e puxa todos os arquivos de todas as suas empresas de uma só vez, em
                        background.</p>
                </div>

                <div class="group p-10 rounded-[2.5rem] bg-white border border-slate-100 hover:border-emerald-200 transition-all duration-500 shadow-[0_20px_50px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(16,185,129,0.08)]"
                    data-aos="fade-up" data-aos-delay="200">
                    <div
                        class="w-16 h-16 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-all duration-500">
                        <i data-lucide="folder-check" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4 items-center flex gap-3"><span
                            class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500 text-white text-[10px]">✓</span>
                        Organização</h3>
                    <p class="text-slate-500 leading-relaxed font-medium">Acabou a bagunça no 'Downloads'. O sistema
                        cria automaticamente as pastas que o seu ERP exige (ex: C:\Notas\CNPJ\Ano-Mes\Emitidas).</p>
                </div>

                <div class="group p-10 rounded-[2.5rem] bg-white border border-slate-100 hover:border-emerald-200 transition-all duration-500 shadow-[0_20px_50px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(16,185,129,0.08)]"
                    data-aos="fade-up" data-aos-delay="300">
                    <div
                        class="w-16 h-16 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-all duration-500">
                        <i data-lucide="shield-check" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4 items-center flex gap-3"><span
                            class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500 text-white text-[10px]">✓</span>
                        Segurança</h3>
                    <p class="text-slate-500 leading-relaxed font-medium">Nós não somos um sistema em nuvem. Seus
                        certificados A1 e senhas nunca vão para a internet. Tudo é salvo em seu servidor local.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- DOBRA 4: ENTERPRISE -->

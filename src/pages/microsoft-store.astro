---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
    title="Nota Fácil na Microsoft Store | Instalação Segura e Oficial" 
    description="Baixe o Nota Fácil Downloader diretamente da Microsoft Store. Mais segurança, praticidade e atualizações automáticas."
    bodyClass="bg-slate-50 text-slate-900 overflow-x-hidden selection:bg-blue-600 selection:text-white"
>

    <!-- Background Decoration -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-100/40 rounded-full blur-[140px] -mr-64 -mt-64"></div>
        <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-indigo-100/20 rounded-full blur-[100px] -ml-32 -mb-32"></div>
    </div>

    <!-- Hero Section -->
    <section class="relative z-10 pt-32 pb-20">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="flex flex-col lg:flex-row items-center gap-16">
                
                <div class="lg:w-1/2 text-center lg:text-left" data-aos="fade-right">
                    <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-700 rounded-full text-xs font-black uppercase tracking-widest border border-blue-100 mb-8">
                        <i data-lucide="verified" class="w-4 h-4"></i>
                        Editor Verificado Microsoft
                    </div>
                    <h1 class="text-5xl lg:text-7xl font-black text-slate-900 tracking-tight leading-[1.1] mb-8">
                        O Nota Fácil agora é <span class="text-blue-600">App Oficial</span> Windows.
                    </h1>
                    <p class="text-xl text-slate-600 font-medium leading-relaxed mb-10 max-w-xl">
                        Diga adeus aos avisos de segurança e instalações complexas. A versão MSIX traz o padrão de ouro em segurança para o seu escritório contábil.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                        <a href="ms-windows-store://pdp/?productid=9N4GBNDFL550" class="inline-flex items-center gap-4 bg-slate-900 hover:bg-slate-800 text-white px-10 py-5 rounded-2xl font-black shadow-2xl transition transform hover:-translate-y-1 active:scale-95 text-lg group">
                            <i data-lucide="shopping-bag" class="w-6 h-6"></i>
                            BAIXAR NA MICROSOFT STORE
                        </a>
                    </div>
                    
                    <p class="mt-6 text-sm text-slate-400 font-medium">
                        *Disponível para Windows 10 e 11.
                    </p>
                </div>

                <div class="lg:w-1/2 relative" data-aos="fade-left">
                    <div class="relative z-10 bg-white p-4 rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.1)] border border-slate-100">
                        <!-- Mockup da Store Simulado -->
                        <div class="bg-slate-50 rounded-3xl overflow-hidden border border-slate-100">
                            <div class="bg-white px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                                <div class="flex gap-2">
                                    <div class="w-3 h-3 rounded-full bg-slate-200"></div>
                                    <div class="w-3 h-3 rounded-full bg-slate-200"></div>
                                    <div class="w-3 h-3 rounded-full bg-slate-200"></div>
                                </div>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Microsoft Store</div>
                                <div class="w-3"></div>
                            </div>
                            <div class="p-8">
                                <div class="flex gap-6 mb-8">
                                    <div class="w-24 h-24 bg-blue-600 rounded-3xl flex items-center justify-center text-white shadow-lg">
                                        <i data-lucide="download-cloud" class="w-12 h-12"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-2xl font-black text-slate-900 mb-1">Nota Fácil</h3>
                                        <p class="text-sm text-blue-600 font-bold mb-4">ContabilCert Soluções</p>
                                        <div class="flex gap-1 text-yellow-400">
                                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <div class="h-4 bg-slate-200 rounded-full w-full"></div>
                                    <div class="h-4 bg-slate-200 rounded-full w-5/6"></div>
                                    <div class="h-4 bg-slate-200 rounded-full w-4/6"></div>
                                </div>
                                <div class="mt-8 pt-8 border-t border-slate-100 flex justify-end">
                                    <div class="px-8 py-3 bg-blue-600 text-white rounded-xl font-bold text-sm">Instalar</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Decorativo Atrás -->
                    <div class="absolute -top-10 -right-10 w-40 h-40 bg-indigo-500/10 rounded-full blur-3xl -z-10"></div>
                    <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl -z-10"></div>
                </div>

            </div>
        </div>
    </section>

    <!-- Benefícios Grid -->
    <section class="py-24 bg-white relative overflow-hidden">
        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <div class="text-center mb-20">
                <h2 class="text-3xl lg:text-5xl font-black text-slate-900 tracking-tight mb-6">Por que migrar para a versão Store?</h2>
                <p class="text-lg text-slate-600 font-medium max-w-2xl mx-auto">
                    A versão MSIX não é apenas uma nova forma de instalar, é uma evolução completa na forma como o software interage com o Windows.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Benefício 1 -->
                <div class="p-10 bg-slate-50 rounded-[2.5rem] border border-slate-100 hover:border-blue-200 hover:shadow-xl hover:shadow-blue-900/5 transition-all group">
                    <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="shield-check" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">Segurança Nativa</h3>
                    <p class="text-slate-600 leading-relaxed">
                        O Windows reconhece o Nota Fácil como um editor verificado. Isso elimina a tela de "O Windows protegeu o seu computador" e garante a integridade dos seus dados.
                    </p>
                </div>

                <!-- Benefício 2 -->
                <div class="p-10 bg-slate-50 rounded-[2.5rem] border border-slate-100 hover:border-indigo-200 hover:shadow-xl hover:shadow-indigo-900/5 transition-all group">
                    <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="zap" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">Auto-Update</h3>
                    <p class="text-slate-600 leading-relaxed">
                        Esqueça downloads manuais de instaladores. Quando lançarmos uma melhoria ou novo mapeamento de prefeitura, o Windows atualiza o app silenciosamente para você.
                    </p>
                </div>

                <!-- Benefício 3 -->
                <div class="p-10 bg-slate-50 rounded-[2.5rem] border border-slate-100 hover:border-emerald-200 hover:shadow-xl hover:shadow-emerald-900/5 transition-all group">
                    <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                        <i data-lucide="layers" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-900 mb-4">Isolamento Limpo</h3>
                    <p class="text-slate-600 leading-relaxed">
                        O padrão MSIX garante que o aplicativo não "suje" o registro do seu Windows. Se um dia você desinstalar, ele sai completamente sem deixar arquivos residuais.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Final -->
    <section class="py-24 bg-slate-900 text-white relative overflow-hidden">
        <div class="absolute inset-0 bg-blue-600/10 pointer-events-none"></div>
        <div class="container mx-auto px-6 text-center relative z-10">
            <h2 class="text-4xl lg:text-6xl font-black tracking-tight mb-8">Pronto para a nova era?</h2>
            <p class="text-xl text-slate-400 font-medium mb-12 max-w-2xl mx-auto">
                Junte-se a centenas de contadores que já utilizam a versão oficial na Microsoft Store.
            </p>
            <div class="flex flex-col items-center gap-6">
                <a href="ms-windows-store://pdp/?productid=9N4GBNDFL550" class="bg-blue-600 hover:bg-blue-500 text-white px-12 py-6 rounded-2xl font-black shadow-2xl transition transform hover:-translate-y-1 active:scale-95 text-xl tracking-tight">
                    OBTER O NOTA FÁCIL NA STORE
                </a>
                <p class="text-slate-500 text-sm italic">
                    Ao clicar, o aplicativo oficial Microsoft Store será aberto no seu computador.
                </p>
            </div>
        </div>
    </section>

</BaseLayout>

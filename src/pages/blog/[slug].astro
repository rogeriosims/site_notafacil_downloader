---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const postUrl = new URL(`/blog/${post.id}`, Astro.site || 'https://nota-facil.github.io').href;
const imageUrl = post.data.image ? new URL(post.data.image, Astro.site || 'https://nota-facil.github.io').href : new URL('/assets/print.png', Astro.site || 'https://nota-facil.github.io').href;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl
  },
  "headline": post.data.title,
  "description": post.data.description,
  "image": imageUrl,
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Nota Fácil",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/assets/nfd_logo_vetorial.svg', Astro.site || 'https://nota-facil.github.io').href
    }
  },
  "datePublished": post.data.pubDate.toISOString()
});
---
<BaseLayout 
  title={`${post.data.title} | Nota Fácil Downloader`} 
  description={post.data.description}
  ogType="article"
  image={imageUrl}
  articleDate={post.data.pubDate.toISOString()}
  customSchema={schema}
>
  <div class="container mx-auto px-6 py-24 max-w-3xl">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 mb-6 leading-tight">
      {post.data.title}
    </h1>
    <div class="flex items-center gap-4 text-slate-500 font-medium text-sm mb-12 border-b border-slate-200 pb-8">
      <span>Por <strong>{post.data.author}</strong></span>
      <span>&bull;</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('pt-BR')}
      </time>
    </div>
    
    {post.data.image && (
      <img 
        src={post.data.image} 
        alt={post.data.title} 
        class="w-full h-auto object-cover rounded-3xl shadow-lg mb-12 shadow-slate-200/50"
      />
    )}
    
    <article class="prose prose-slate prose-lg max-w-none prose-headings:font-black prose-a:text-blue-600 hover:prose-a:text-blue-500 prose-img:rounded-3xl border-b border-slate-200 pb-16">
      <Content />
    </article>

    <!-- Outros Artigos (Interligação para SEO) -->
    <section class="mt-20">
      <h3 class="text-2xl font-black text-slate-900 mb-8 flex items-center gap-3">
        <i data-lucide="book-open" class="w-6 h-6 text-blue-600"></i>
        Leia Também
      </h3>
      <div class="grid sm:grid-cols-2 gap-8">
        {(await getCollection('blog'))
          .filter(p => p.id !== post.id)
          .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
          .slice(0, 2)
          .map(otherPost => (
            <a href={`/blog/${otherPost.id}`} class="group bg-white p-6 rounded-[2rem] border border-slate-200 hover:border-blue-200 shadow-sm hover:shadow-lg transition-all flex flex-col gap-4">
              <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">{otherPost.data.pubDate.toLocaleDateString('pt-BR')}</span>
              <h4 class="text-lg font-black text-slate-800 leading-tight group-hover:text-blue-600 transition-colors">{otherPost.data.title}</h4>
              <p class="text-sm text-slate-500 line-clamp-2">{otherPost.data.description}</p>
              <span class="text-blue-600 font-bold text-xs mt-2 group-hover:translate-x-1 transition-transform inline-block">Ler agora &rarr;</span>
            </a>
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <a href="/blog" class="inline-flex items-center gap-2 text-slate-400 hover:text-blue-600 font-bold text-sm transition-colors">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          Ver todos os artigos do blog
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

---
<!--
  CookieConsent.astro - Banner de Consentimento LGPD
  Conformidade:
  - Botões com peso visual equivalente (sem dark patterns)
  - Granularidade: opção "Somente Necessários" separada de "Aceitar Todos"
  - GTM/GA só são ativados APÓS consentimento analítico explícito
  - Consentimento guardado com timestamp e versão para auditoria
-->
<div
  id="cookie-consent-banner"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-desc"
  aria-hidden="true"
  inert
  class="fixed bottom-6 left-6 right-6 md:left-auto md:right-6 md:max-w-md z-50 bg-slate-900/97 backdrop-blur-md border border-slate-700 p-6 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.4)] transform translate-y-10 opacity-0 pointer-events-none transition-all duration-500 flex flex-col gap-4"
>
    <div class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-500/10 text-blue-400 rounded-xl flex items-center justify-center shrink-0 border border-blue-500/20 mt-0.5">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
        </div>
        <div>
            <h4 id="cookie-banner-title" class="text-sm font-black text-white uppercase tracking-wider">Privacidade e Cookies</h4>
            <p id="cookie-banner-desc" class="text-xs text-slate-300 leading-relaxed font-medium mt-1">
                Usamos cookies analíticos (Google Analytics, Google Ads) para entender o tráfego e melhorar o site.
                Você pode aceitar todos, aceitar apenas os essenciais ou <a href="/politica-de-privacidade/" class="text-blue-400 hover:text-blue-300 underline underline-offset-2 font-semibold">ver a política completa</a>.
            </p>
        </div>
    </div>

    <!-- Detalhes expansíveis das categorias -->
    <div class="bg-slate-800/60 rounded-2xl p-4 text-xs text-slate-400 space-y-2 border border-slate-700/50">
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
            <strong class="text-slate-200">Essenciais</strong>
            <span class="ml-auto text-slate-500">Sempre ativos</span>
        </div>
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-400 shrink-0"></span>
            <strong class="text-slate-200">Analíticos</strong>
            <span class="text-slate-400">Google Analytics, Google Ads, Cloudflare</span>
        </div>
    </div>

    <!-- Botões com peso visual equivalente (anti dark-pattern LGPD) -->
    <div class="flex flex-col sm:flex-row gap-2 pt-2 border-t border-slate-800/80">
        <button
            type="button"
            id="cookie-necessary-btn"
            class="flex-1 text-xs text-slate-300 hover:text-white border border-slate-700 hover:border-slate-500 px-4 py-2.5 rounded-xl font-bold transition-all text-center"
        >
            Só Essenciais
        </button>
        <button
            type="button"
            id="cookie-accept-btn"
            class="flex-1 bg-blue-600 hover:bg-blue-500 text-white text-xs font-black px-6 py-2.5 rounded-xl transition-all shadow-md shadow-blue-500/20 hover:shadow-blue-500/30 text-center"
        >
            Aceitar Todos
        </button>
    </div>
    <p class="text-[10px] text-slate-600 text-center -mt-1">
        Conforme a LGPD (Lei nº 13.709/2018) você pode revogar este consentimento a qualquer momento.
    </p>
</div>

<script is:inline>
(function () {
    'use strict';

    var CONSENT_KEY = 'nfd_cookie_consent_v1';
    var CONSENT_VERSION = '1.0';

    function getConsent() {
        try {
            var raw = localStorage.getItem(CONSENT_KEY);
            return raw ? JSON.parse(raw) : null;
        } catch (e) {
            return null;
        }
    }

    function saveConsent(analytics) {
        try {
            localStorage.setItem(CONSENT_KEY, JSON.stringify({
                version: CONSENT_VERSION,
                analytics: analytics,
                timestamp: new Date().toISOString()
            }));
        } catch (e) {}
    }

    function loadGTM() {
        // Só carrega GTM depois de consentimento analítico explícito
        if (document.querySelector('script[data-gtm-loaded]')) return;

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
            'gtm.start': new Date().getTime(),
            event: 'gtm.js'
        });

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-KHF7CGHF';
        s.setAttribute('data-gtm-loaded', '1');
        document.head.appendChild(s);
    }

    function notifyConsentMode(analytics) {
        // Google Consent Mode v2
        window.gtag = window.gtag || function () {
            (window.dataLayer = window.dataLayer || []).push(arguments);
        };
        window.gtag('consent', 'update', {
            'analytics_storage': analytics ? 'granted' : 'denied',
            'ad_storage': analytics ? 'granted' : 'denied',
            'ad_user_data': analytics ? 'granted' : 'denied',
            'ad_personalization': analytics ? 'granted' : 'denied'
        });
    }

    function hideBanner(banner) {
        // O clique deixa o foco no botão. Aplicar aria-hidden a um ancestral do
        // elemento focado é violação de acessibilidade (o navegador bloqueia e
        // avisa no console), então devolvemos o foco ao body antes de ocultar.
        if (banner.contains(document.activeElement)) {
            document.activeElement.blur();
        }
        banner.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
        banner.setAttribute('aria-hidden', 'true');
        // inert remove o banner da navegação por teclado e da árvore de acessibilidade
        banner.setAttribute('inert', '');
    }

    function init() {
        var banner = document.getElementById('cookie-consent-banner');
        var acceptBtn = document.getElementById('cookie-accept-btn');
        var necessaryBtn = document.getElementById('cookie-necessary-btn');

        if (!banner || !acceptBtn || !necessaryBtn) return;

        var consent = getConsent();

        if (consent !== null) {
            // Consentimento já registrado — aplica silenciosamente.
            // A ordem importa: o consent update precisa entrar no dataLayer ANTES
            // do container subir, senão as tags avaliam o estado antigo (negado).
            notifyConsentMode(consent.analytics);
            if (consent.analytics) loadGTM();
            hideBanner(banner);
            return;
        }

        // Nenhuma resposta ainda — mostra o banner
        setTimeout(function () {
            banner.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
            banner.removeAttribute('aria-hidden');
            banner.removeAttribute('inert');
        }, 1000);

        acceptBtn.addEventListener('click', function () {
            saveConsent(true);
            notifyConsentMode(true);
            loadGTM();
            hideBanner(banner);
        });

        necessaryBtn.addEventListener('click', function () {
            saveConsent(false);
            notifyConsentMode(false);
            hideBanner(banner);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
